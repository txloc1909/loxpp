<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!-- This project has no PackageReference at all; restore needs to fetch
       nothing, so no package source is configured. The dev-managed image
       has no network at test time (see RT.md), and an unconfigured source
       list makes `dotnet build`'s implicit restore try nuget.org anyway
       (NuGet's automatic vulnerability audit contacts a configured source
       even with zero packages to resolve). -->
  <packageSources>
    <clear />
  </packageSources>
</configuration>
