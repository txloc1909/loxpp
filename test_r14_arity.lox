// R14 reproduction 2: ArityError in a deferred call, caught by outer try/catch
// Expected: catch block runs, prints "caught: ArityError"
// Current (broken): spurious error message, exit 70

fun f(a) {
  return a;
}

fun outer() {
  defer f();  // arity error: f expects 1 arg, gets 0
  print "body";
}

try {
  outer();
} catch (e) {
  print "caught: " + e.kind;
}
