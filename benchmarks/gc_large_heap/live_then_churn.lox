// Keep many live instances, then make many short-lived ones.
class Node { init(i) { this.i = i; } }

var LIVE = 3000000;
var CHURN = 6000000;

var keep = [];
var i = 0;
while (i < LIVE) { keep.append(Node(i)); i = i + 1; }

i = 0;
var sum = 0;
while (i < CHURN) { var t = Node(i); sum = sum + t.i; i = i + 1; }
print sum + len(keep);
