// A Map with millions of entries, then updates that make garbage.
// The keys are Strings: Int keys are slow above about 1 million entries
// (#1287).
class Node { init(i) { this.i = i; } }

var N = 2000000;
var ROUNDS = 3000000;
var keys = [];
var j = 0;
while (j < N) { keys.append("k" + str(j)); j = j + 1; }

var m = {};
var i = 0;
while (i < N) { m[keys[i]] = Node(i); i = i + 1; }

i = 0;
while (i < ROUNDS) {
    m[keys[(i * 7919) % N]] = Node(i);
    i = i + 1;
}
print len(m);
