// GC pause latency: time each small unit of work while a large object graph
// stays live, so a unit that includes a collection stands out from the rest.
//
// Output (one line, values in microseconds except the counts and checksum):
//   LATENCY <units> <live-nodes> <p50> <p99> <max> <checksum>
// Percentile p is the sample at sorted index floor(p * (units - 1)).

var LIVE_NODES = 50000;
var WARMUP_UNITS = 1000;
var MEASURED_UNITS = 10000;
var ALLOCS_PER_UNIT = 100;

class Node {
  init(id) {
    this.id = id;
    this.payload = [id, id + 1];
  }
}

fun buildGraph(n) {
  var slots = [];
  var i = 0;
  while (i < n) {
    slots.append(Node(i));
    i = i + 1;
  }
  return slots;
}

fun unit(slots, seq) {
  var sum = 0;
  var i = 0;
  while (i < ALLOCS_PER_UNIT) {
    var tmp = Node(seq + i);
    sum = sum + tmp.payload[1];
    i = i + 1;
  }
  var slot = (seq * 7919) % LIVE_NODES;
  // Only `slots` references a node, so the replaced node becomes garbage
  // and the live set stays at LIVE_NODES. Old objects keep dying and new
  // ones keep being stored into old storage, so a collector cannot treat
  // the graph as frozen.
  var fresh = Node(seq);
  slots[slot] = fresh;
  return sum + fresh.id;
}

fun merge(a, b) {
  var out = [];
  var i = 0;
  var j = 0;
  var na = len(a);
  var nb = len(b);
  while (i < na and j < nb) {
    if (a[i] <= b[j]) {
      out.append(a[i]);
      i = i + 1;
    } else {
      out.append(b[j]);
      j = j + 1;
    }
  }
  while (i < na) { out.append(a[i]); i = i + 1; }
  while (j < nb) { out.append(b[j]); j = j + 1; }
  return out;
}

fun mergeSort(xs, lo, hi) {
  if (hi - lo <= 1) return [xs[lo]];
  var mid = lo + math.floor((hi - lo) / 2);
  return merge(mergeSort(xs, lo, mid), mergeSort(xs, mid, hi));
}

fun percentile(sorted, p) {
  return sorted[math.floor(p * (len(sorted) - 1))];
}

var slots = buildGraph(LIVE_NODES);
var checksum = 0;

var seq = 0;
while (seq < WARMUP_UNITS) {
  checksum = (checksum + unit(slots, seq)) % 1000003;
  seq = seq + 1;
}

var samples = [];
var k = 0;
while (k < MEASURED_UNITS) {
  var t0 = clock();
  checksum = (checksum + unit(slots, seq)) % 1000003;
  samples.append((clock() - t0) * 1000000.0);
  seq = seq + 1;
  k = k + 1;
}

var sorted = mergeSort(samples, 0, len(samples));
print "LATENCY " + str(MEASURED_UNITS) + " " + str(LIVE_NODES) + " "
    + str(percentile(sorted, 0.5)) + " " + str(percentile(sorted, 0.99)) + " "
    + str(sorted[MEASURED_UNITS - 1]) + " " + str(checksum);
