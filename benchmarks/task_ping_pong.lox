// Pure message ping-pong between two tasks: 1,000,000 task switches, no park.
// It measures the cost of one task switch. benchmarks/task_switch_cost.sh runs
// it: it alternates the runs of two release builds on one pinned core and
// reads the user plus system CPU time. By hand:
//   taskset -c 3 build/loxpp benchmarks/task_ping_pong.lox
// Wall time is noisy and no instruction counter is in the dev image, so use
// 15 runs or more of each build and compare the medians.
var N = 500000;
var main = task.self();
fun echo() {
    var i = 0;
    while (i < N) {
        var m = task.receive();
        task.send(main, m);
        i = i + 1;
    }
}
var t = task.spawn(echo);
var i = 0;
while (i < N) {
    task.send(t, i);
    task.receive();
    i = i + 1;
}
print "done";
