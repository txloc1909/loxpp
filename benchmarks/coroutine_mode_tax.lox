// The QBE coroutine-mode tax on a program that never suspends.
//
// Run: tools/loxpp_qbe.sh benchmarks/coroutine_mode_tax.lox
//
// Identical to benchmarks/coroutine_mode_floor.lox plus one function that is
// never called and whose body does contain a `yield`. On the native VM the
// extra function changes nothing. On the QBE backend a reached `YIELD` still
// compiles the whole program in coroutine mode (docs/decisions/coroutines.md,
// "Backends"): the mode covers every function, because calls are dynamic, so
// a `yield` in an uncalled function is still one a frame could suspend at.
// Every function becomes a resume-block state machine driven by the runtime,
// and register promotion is off. The difference between this number and the
// floor's is what every call pays for that rule.
//
// benchmarks/coroutine_mode_dead_yield.lox is the same program with the
// `yield` where no path reaches it: that one keeps the floor's cost.

fun step(i, limit) {
    if (i < limit) return i + 1;
    return i;
}

fun run(reps) {
    var i = 0;
    while (i < reps) {
        i = step(i, reps);
    }
    return i;
}

fun neverCalled() {
    yield 0;
}

var REPS = 200000;
var start = clock();
run(REPS);
var elapsed = clock() - start;
print elapsed / REPS * 1000000000.0;
