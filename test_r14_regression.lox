// Test various catchable error types with try/catch (no defer-throwing scenario)
// to ensure no regression from the refactor

// Test 1: IndexOutOfBoundsError
try {
  var list = [1, 2, 3];
  list[10];
} catch (e) {
  print "Test 1 OK: " + e.kind;
}

// Test 2: ComparisonTypeError
try {
  var x = 5 < "string";
} catch (e) {
  print "Test 2 OK: " + e.kind;
}

// Test 3: ArithmeticTypeError
try {
  var x = 5 + "string";
} catch (e) {
  print "Test 3 OK: " + e.kind;
}

// Test 4: NotCallableError
try {
  var x = 5;
  x();
} catch (e) {
  print "Test 4 OK: " + e.kind;
}

// Test 5: UndefinedVariableError
try {
  print undefined_var;
} catch (e) {
  print "Test 5 OK: " + e.kind;
}

// Test 6: EmptyListError (pop on empty list)
try {
  var list = [];
  list.pop();
} catch (e) {
  print "Test 6 OK: " + e.kind;
}

// Test 7: Nested try/catch with cross-frame throw
fun throwError() {
  var list = [1, 2, 3];
  list[10];
}

try {
  throwError();
} catch (e) {
  print "Test 7 OK: " + e.kind;
}

print "All tests completed";
