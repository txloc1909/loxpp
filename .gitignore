# Prerequisites
*.d

# Compiled Object files
*.slo
*.lo
*.o
*.obj

# Precompiled Headers
*.gch
*.pch

# Compiled Dynamic libraries
*.so
*.dylib
*.dll

# Fortran module files
*.mod
*.smod

# Compiled Static libraries
*.lai
*.la
*.a
*.lib

# Executables
*.exe
*.out
*.app

build/
build-*/
.cache/
.ccache/
.vscode/
.claude/worktrees/

# benchmark programs are generated from benchmarks/core/ by generate.py
benchmarks/programs/

# benchmark run outputs — keep only the committed baselines
benchmarks/results/*
!benchmarks/results/baseline_*.json
!benchmarks/results/profile_*.json

# JVM runtime library build output (tools/build_lox_rt.sh)
runtime/jvm/classes/
runtime/jvm/test-classes/
runtime/jvm/lox-rt.jar

# CLR runtime library and run-host build output (tools/build_lox_rt_clr.sh)
runtime/clr/**/bin/
runtime/clr/**/obj/
runtime/clr/LoxRuntime.dll
runtime/clr/LoxHost.dll
runtime/clr/LoxHost.runtimeconfig.json
__pycache__/
*.pyc

# tree-sitter grammar (editors/tree-sitter-loxpp): npm and build output.
# The generated parser under editors/tree-sitter-loxpp/src/ is committed.
node_modules/
editors/tree-sitter-loxpp/package-lock.json
editors/tree-sitter-loxpp/build/
editors/tree-sitter-loxpp/target/
editors/tree-sitter-loxpp/Cargo.lock
editors/tree-sitter-loxpp/*.wasm
