// Test for issue #253: Error value properties should be catchable
// Both native and JVM should allow accessing .kind, .message, and undefined properties

// CHECK: kind=TestError
// CHECK: message=test error message
// CHECK: undefined property caught

try {
  throw "x";
} catch (e) {
  // e is a thrown string wrapped as an Error-like value
  // Test accessing properties on the caught value
  print "kind=" + e.kind;
  print "message=" + e.message;

  // Try accessing an undefined property on the caught error
  try {
    print e.bogusField;
  } catch (e2) {
    print "undefined property caught";
  }
}
print "after";
