var a = "\"";
//       ^ string.escape
var b = "\\";
//       ^ string.escape
var c = "\n";
//       ^ string.escape
var d = "\t";
//       ^ string.escape
var e = "\r";
//       ^ string.escape
var f = "\0";
//       ^ string.escape

enum Tree { Leaf(v) Node(l, r) Empty }
// <- keyword
//   ^ type
//          ^ constructor

fun size(t) {
  return match t {
//       ^ keyword.conditional
    case Tree.Leaf(v) => v
//  ^ keyword.conditional
//       ^ type
//            ^ constructor
    case node @ Tree.Node(l, r) => size(l) + size(r)
//       ^ variable
//                   ^ constructor
//                                 ^ function.call
    case Tree.Empty => 0
//       ^ type
//            ^ constructor
    case Point => 0
//       ^ type
    case _ => 0
//       ^ variable.builtin
  };
}

var leaf = Tree.Leaf(1);
//         ^ type
//              ^ constructor

class Point < Shape {
//    ^ type
//            ^ type
  area() { return this.w; }
//                ^ variable.builtin
//                     ^ variable.member
  base() { return super.area; }
//                ^ variable.builtin
//                      ^ variable.member
}
