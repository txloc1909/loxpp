var a = "\"";
//       ^ string.escape
var b = "\\";
//       ^ string.escape
var c = "\n";
//       ^ string.escape
var d = "\t";
//       ^ string.escape
var e = "\r";
//       ^ string.escape
var f = "\0";
//       ^ string.escape

enum Tree { Leaf(v) Node(l, r) }
// <- keyword
//   ^ type
//          ^ constructor

fun size(t) {
  return match t {
//       ^ keyword.conditional
    case Leaf(v) => v
//  ^ keyword.conditional
//       ^ constructor
    case node @ Node(l, r) => size(l) + size(r)
//       ^ variable
//              ^ constructor
//                            ^ function.call
    case Empty => 0
//       ^ constructor
    case _ => 0
//       ^ variable.builtin
  };
}

class Point < Shape {
//    ^ type
//            ^ type
  area() { return this.w; }
//                ^ variable.builtin
//                     ^ variable.member
  base() { return super.area; }
//                ^ variable.builtin
//                      ^ variable.member
}
