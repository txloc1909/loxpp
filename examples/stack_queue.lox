// stack_queue.lox — Stack and Queue classes backed by dynamic lists.
//
// Stack: LIFO — append to push, pop to pop.
// Queue: FIFO — two-stack trick for amortized O(1) dequeue.
//
// The last section gives both classes the container protocols, so they also
// work with len(), `in`, and for-in like built-in sequences.
//
// Demonstrates: classes encapsulating lists, append, pop, len(), and the
//               container protocols (__len__ __contains__ __iter__).

class Stack {
    init() { this.data = []; }

    push(value) { this.data.append(value); }

    pop() {
        if (this.isEmpty()) {
            print "Stack underflow!";
            return nil;
        }
        return this.data.pop();
    }

    peek() {
        if (this.isEmpty()) return nil;
        return this.data[len(this.data) - 1];
    }

    isEmpty() { return len(this.data) == 0; }
    size()    { return len(this.data); }

    __len__() { return len(this.data); }
    __contains__(v) {
        var i = 0;
        while (i < len(this.data)) {
            if (this.data[i] == v) return true;
            i = i + 1;
        }
        return false;
    }
    __iter__() { return this.data[0:len(this.data)]; }
}

// Two-stack queue: inbox receives enqueues; dequeue transfers to outbox when needed.
class Queue {
    init() {
        this.inbox  = [];
        this.outbox = [];
    }

    enqueue(value) { this.inbox.append(value); }

    dequeue() {
        if (len(this.outbox) == 0) {
            while (len(this.inbox) > 0) {
                this.outbox.append(this.inbox.pop());
            }
        }
        if (len(this.outbox) == 0) {
            print "Queue is empty!";
            return nil;
        }
        return this.outbox.pop();
    }

    isEmpty() { return len(this.inbox) == 0 and len(this.outbox) == 0; }
    size()    { return len(this.inbox) + len(this.outbox); }

    __len__() { return len(this.inbox) + len(this.outbox); }
    __contains__(v) {
        var i = 0;
        while (i < len(this.inbox)) {
            if (this.inbox[i] == v) return true;
            i = i + 1;
        }
        i = 0;
        while (i < len(this.outbox)) {
            if (this.outbox[i] == v) return true;
            i = i + 1;
        }
        return false;
    }
    __iter__() {
        var out = [];
        var i = len(this.outbox) - 1;      // outbox holds the front, reversed
        while (i >= 0) { out.append(this.outbox[i]); i = i - 1; }
        i = 0;
        while (i < len(this.inbox)) { out.append(this.inbox[i]); i = i + 1; }
        return out;
    }
}

// CHECK: === Stack (LIFO) ===
print "=== Stack (LIFO) ===";
var s = Stack();
s.push(10);
s.push(20);
s.push(30);
print "size=" + str(s.size()) + "  peek=" + str(s.peek());
// CHECK: size=3  peek=30
print "pop: " + str(s.pop());
// CHECK: pop: 30
print "pop: " + str(s.pop());
// CHECK: pop: 20
s.push(99);
print "pop: " + str(s.pop());
// CHECK: pop: 99
print "pop: " + str(s.pop());
// CHECK: pop: 10
print "empty? " + str(s.isEmpty());
// CHECK: empty? true

print "";
// CHECK: === Queue (FIFO, two-stack) ===
print "=== Queue (FIFO, two-stack) ===";
var q = Queue();
q.enqueue("a");
q.enqueue("b");
q.enqueue("c");
print "dequeue: " + str(q.dequeue());
// CHECK: dequeue: a
q.enqueue("d");
print "dequeue: " + str(q.dequeue());
// CHECK: dequeue: b
print "dequeue: " + str(q.dequeue());
// CHECK: dequeue: c
print "dequeue: " + str(q.dequeue());
// CHECK: dequeue: d
print "empty? " + str(q.isEmpty());
// CHECK: empty? true

print "";
// CHECK: === Stack as bracket-matching checker ===
print "=== Stack as bracket-matching checker ===";
fun isBalanced(tokens, n) {
    var stk = Stack();
    var i = 0;
    while (i < n) {
        var t = tokens[i];
        if (t == "(" or t == "[" or t == "{") {
            stk.push(t);
        } else if (t == ")") {
            if (stk.isEmpty() or stk.pop() != "(") return false;
        } else if (t == "]") {
            if (stk.isEmpty() or stk.pop() != "[") return false;
        } else if (t == "}") {
            if (stk.isEmpty() or stk.pop() != "{") return false;
        }
        i = i + 1;
    }
    return stk.isEmpty();
}

var balanced   = ["(", "[", "{", "}", "]", ")"];
var unbalanced = ["(", "[", "}", "]", ")"];
print "balanced:   " + str(isBalanced(balanced, 6));
// CHECK: balanced:   true
print "unbalanced: " + str(isBalanced(unbalanced, 5));
// CHECK: unbalanced: false

// -----------------------------------------------------------------------
// Protocol view — the same objects now work with len(), `in`, and for-in.
// -----------------------------------------------------------------------

// CHECK: === Protocol-enabled Stack and Queue ===
print "";
print "=== Protocol-enabled Stack and Queue ===";

var ps = Stack();
ps.push(10);
ps.push(20);
ps.push(30);
// CHECK: len(stack)  = 3
print "len(stack)  = " + str(len(ps));
// CHECK: 20 in stack = true
print "20 in stack = " + str(20 in ps);
// CHECK: 99 in stack = false
print "99 in stack = " + str(99 in ps);
var stackSum = 0;
for (var value in ps) stackSum = stackSum + value;
// CHECK: sum(stack)  = 60
print "sum(stack)  = " + str(stackSum);

var pq = Queue();
pq.enqueue("a");
pq.enqueue("b");
pq.enqueue("c");
pq.dequeue();                 // "a" leaves, so the queue is "b", "c"
// CHECK: len(queue)  = 2
print "len(queue)  = " + str(len(pq));
// CHECK: "b" in queue = true
print "\"b\" in queue = " + str("b" in pq);
// CHECK: "a" in queue = false
print "\"a\" in queue = " + str("a" in pq);
var order = "";
for (var item in pq) order = order + item;
// CHECK: fifo order = bc
print "fifo order = " + order;
