// flatten.lox — Flatten an arbitrarily nested list structure.
//
// In Lox++ there is no type-test for List vs scalar, so we use a wrapper
// class to distinguish "a node that is itself a list" from a plain value.
// The Node also implements the iteration protocol, so a for-in over any tree
// yields its leaves in order.
//
// Demonstrates: append, len(), recursion, classes as tagged unions, and
//               the iteration protocol (__iter__ __len__).

class Node {
    init(value, isList) {
        this.value  = value;   // Number/String/bool/nil  OR  a List of Node
        this.isList = isList;
    }

    __iter__() { return flatten(this); }

    __len__() {
        if (!this.isList) return 1;
        var total = 0;
        var i = 0;
        while (i < len(this.value)) {
            total = total + len(this.value[i]);
            i = i + 1;
        }
        return total;
    }
}

fun leaf(v)     { return Node(v, false); }
fun branch(lst) { return Node(lst, true); }

fun flattenInto(node, result) {
    if (!node.isList) {
        result.append(node.value);
    } else {
        var i = 0;
        while (i < len(node.value)) {
            flattenInto(node.value[i], result);
            i = i + 1;
        }
    }
}

fun flatten(node) {
    var result = [];
    flattenInto(node, result);
    return result;
}

fun printList(lst) {
    var s = "[";
    var i = 0;
    while (i < len(lst)) {
        s = s + str(lst[i]);
        if (i < len(lst) - 1) s = s + ", ";
        i = i + 1;
    }
    print s + "]";
}

// CHECK: === Flatten Nested Lists ===
print "=== Flatten Nested Lists ===";

// [1, [2, 3], [4, [5, 6]], 7]
var nested = branch([
    leaf(1),
    branch([leaf(2), leaf(3)]),
    branch([leaf(4), branch([leaf(5), leaf(6)])]),
    leaf(7)
]);
printList(flatten(nested));   // [1, 2, 3, 4, 5, 6, 7]
// CHECK: [1, 2, 3, 4, 5, 6, 7]

// deeply nested: [[[42]]]
var deep = branch([branch([branch([leaf(42)])])]);
printList(flatten(deep));     // [42]
// CHECK: [42]

// mixed types: [1, "hi", [true, nil]]
var mixed = branch([leaf(1), leaf("hi"), branch([leaf(true), leaf(nil)])]);
printList(flatten(mixed));    // [1, hi, true, nil]
// CHECK: [1, hi, true, nil]

// -----------------------------------------------------------------------
// The tree is itself iterable — for-in yields the leaves in order.
// -----------------------------------------------------------------------

// Iterating a Node walks its leaves.
print "";
// CHECK: iterate leaves:
print "iterate leaves:";
var collected = [];
for (var x in nested) collected.append(x);
printList(collected);
// CHECK: [1, 2, 3, 4, 5, 6, 7]

// CHECK: len(nested) = 7
print "len(nested) = " + str(len(nested));
// CHECK: len(deep) = 1
print "len(deep) = " + str(len(deep));
