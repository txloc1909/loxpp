// memo_fib.lox — Memoized Fibonacci as a callable cache object.
//
// `Memoize` wraps a function and stores results in a Map. An Instance with
// `__call__` is callable, so `fastFib(n)` reads exactly like a function call.
//
// Demonstrates: callable objects (__call__), Map as a DP cache, has(),
//               index get/set, len().

class Memoize {
    init(fn) {
        this.fn = fn;
        this.cache = {};
    }

    __call__(n) {
        if (this.cache.has(n)) return this.cache[n];
        var result = this.fn(n);
        this.cache[n] = result;
        return result;
    }
}

fun slowFib(n) {
    if (n <= 1) return n;
    return fastFib(n - 1) + fastFib(n - 2);
}

var fastFib = Memoize(slowFib);

fun fibNaive(n) {
    if (n <= 1) return n;
    return fibNaive(n - 1) + fibNaive(n - 2);
}

// CHECK: === Memoized Fibonacci ===
print "=== Memoized Fibonacci ===";

var i = 0;
while (i <= 10) {
    print "fib(" + str(i) + ") = " + str(fastFib(i));
    i = i + 1;
}
// CHECK: fib(0) = 0
// CHECK: fib(1) = 1
// CHECK: fib(2) = 1
// CHECK: fib(3) = 2
// CHECK: fib(4) = 3
// CHECK: fib(5) = 5
// CHECK: fib(6) = 8
// CHECK: fib(7) = 13
// CHECK: fib(8) = 21
// CHECK: fib(9) = 34
// CHECK: fib(10) = 55

print "";
// CHECK: fib(30) = 832040
print "fib(30) = " + str(fastFib(30));
// CHECK: fib(35) = 9.22746e+06
print "fib(35) = " + str(fastFib(35));

// The cache is a field of the callable object, not a global.
// CHECK: cache entries: 36
print "cache entries: " + str(len(fastFib.cache));

// Correctness: memoized matches naive for small n
// CHECK: === Correctness check ===
print "";
print "=== Correctness check ===";
var ok = true;
var n = 0;
while (n <= 15) {
    if (fastFib(n) != fibNaive(n)) {
        print "MISMATCH at n=" + str(n);
        ok = false;
    }
    n = n + 1;
}
// CHECK: all match: true
if (ok) print "all match: true";
