// Same defect class as try_catch_if_else_in_catch_body.lox, but with the
// spec's own recommended catch-discrimination idiom (spec/02-syntax.md:
// "a program that needs to discriminate the shape of a thrown value does
// so with `match` inside `catchBlock`"). A `match` arm's own dispatch
// label is exactly the kind of internal label the old scan-based
// resolveRegions() could not tell apart from the true end of the handler.
// Followed by a sibling try/catch, so a truncated region also corrupts
// unrelated code after it.

enum Shape { Circle(r) Square(side) }
fun f() {
    try {
        throw Circle(3);
    } catch (e) {
        var described = match e {
            case Circle(r)    => "caught a circle r=" + str(r)
            case Square(side) => "caught a square side=" + str(side)
            case _            => "caught something else"
        };
        print described;
    }
    try { throw "sibling-fault"; }
    catch (e2) { print "sibling caught: " + e2; }
}
f();

// CHECK: caught a circle r=3
// CHECK: sibling caught: sibling-fault
