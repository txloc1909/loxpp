// Regression: `return` inside a try body that IS actually reached at
// runtime (not dead code left over from an earlier terminal catch). The
// return must leave the guarded region correctly, not fall through the
// handler. A defer-using function gets this for free from its own outer
// handler wrapping (Emitter::deferReturnSlot); this checks the analogous
// path for a function with no defer at all (Emitter::handlerReturnSlot).

fun withReturnInTry(shouldThrow) {
    try {
        if (shouldThrow) {
            throw "boom";
        }
        return "no-throw-path";
    } catch (e) {
        print "caught: " + e;
    }
    print "after try/catch";
}
print withReturnInTry(false);
print withReturnInTry(true);

// CHECK: no-throw-path
// CHECK: caught: boom
// CHECK: after try/catch
