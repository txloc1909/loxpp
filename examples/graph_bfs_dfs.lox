// graph_bfs_dfs.lox — BFS and DFS on an undirected graph.
//
// The graph is a `Graph` object keyed by node name. Its operators make it
// behave like a container: g[name] gives neighbours, `name in g` tests
// membership, len(g) counts nodes, and for-in walks the node list. Visited
// sets are still Maps used as hash sets (value = true).
//
// Demonstrates: operator overloading (__index_get__ __contains__ __iter__
//   __len__), Map of Lists, has(), an index-based BFS queue, recursive DFS.

// -----------------------------------------------------------------------
// Graph definition
// -----------------------------------------------------------------------
//
//   A --- B --- D
//   |     |
//   C     E
//   |     |
//   F ----+

class Graph {
    init() {
        this.adj = {};
        this.nodes = [];
    }

    addNode(name) {
        if (!this.adj.has(name)) {
            this.adj[name] = [];
            this.nodes.append(name);
        }
    }

    // Undirected: each edge is stored on both endpoints.
    addEdge(a, b) {
        this.addNode(a);
        this.addNode(b);
        this.adj[a].append(b);
        this.adj[b].append(a);
    }

    __index_get__(name) { return this.adj[name]; }
    __contains__(name) { return this.adj.has(name); }
    __iter__() { return this.nodes[0:len(this.nodes)]; }
    __len__() { return len(this.nodes); }
}

// Edges are added in adjacency-list order, so traversals below are unchanged.
var g = Graph();
g.addEdge("A", "B");
g.addEdge("A", "C");
g.addEdge("B", "D");
g.addEdge("B", "E");
g.addEdge("C", "F");
g.addEdge("E", "F");

// -----------------------------------------------------------------------
// Helpers
// -----------------------------------------------------------------------

fun listJoin(lst, sep) {
    var s = "";
    var i = 0;
    while (i < len(lst)) {
        if (i > 0) s = s + sep;
        s = s + lst[i];
        i = i + 1;
    }
    return s;
}

// -----------------------------------------------------------------------
// BFS — level-order traversal using an index-based queue
// -----------------------------------------------------------------------

fun bfs(start) {
    var visited = {};
    var queue = [start];
    var head = 0;
    var result = [];
    visited[start] = true;

    while (head < len(queue)) {
        var node = queue[head];
        head = head + 1;
        result.append(node);

        var neighbours = g[node];
        var i = 0;
        while (i < len(neighbours)) {
            var nb = neighbours[i];
            if (!visited.has(nb)) {
                visited[nb] = true;
                queue.append(nb);
            }
            i = i + 1;
        }
    }
    return result;
}

// -----------------------------------------------------------------------
// DFS — recursive, accumulates nodes in visit order
// -----------------------------------------------------------------------

fun dfsVisit(node, visited, result) {
    visited[node] = true;
    result.append(node);
    var neighbours = g[node];
    var i = 0;
    while (i < len(neighbours)) {
        var nb = neighbours[i];
        if (!visited.has(nb)) dfsVisit(nb, visited, result);
        i = i + 1;
    }
}

fun dfs(start) {
    var visited = {};
    var result = [];
    dfsVisit(start, visited, result);
    return result;
}

// -----------------------------------------------------------------------
// Shortest path (BFS-based)
// -----------------------------------------------------------------------

fun shortestPath(start, goal) {
    if (start == goal) return [start];
    var visited = {};
    var queue = [start];
    var head = 0;
    var parent = {};   // Map: node -> node it was reached from
    visited[start] = true;

    while (head < len(queue)) {
        var node = queue[head];
        head = head + 1;
        var neighbours = g[node];
        var i = 0;
        while (i < len(neighbours)) {
            var nb = neighbours[i];
            if (!visited.has(nb)) {
                visited[nb] = true;
                parent[nb] = node;
                if (nb == goal) {
                    // Reconstruct path
                    var path = [];
                    var cur = goal;
                    while (cur != start) {
                        path.append(cur);
                        cur = parent[cur];
                    }
                    path.append(start);
                    // Reverse
                    var lo = 0;
                    var hi = len(path) - 1;
                    while (lo < hi) {
                        var tmp = path[lo];
                        path[lo] = path[hi];
                        path[hi] = tmp;
                        lo = lo + 1;
                        hi = hi - 1;
                    }
                    return path;
                }
                queue.append(nb);
            }
            i = i + 1;
        }
    }
    return nil;   // no path
}

// -----------------------------------------------------------------------
// Output
// -----------------------------------------------------------------------

// CHECK: === Graph traversal from A ===
print "=== Graph traversal from A ===";
// CHECK: BFS: A, B, C, D, E, F
print "BFS: " + listJoin(bfs("A"), ", ");
// CHECK: DFS: A, B, D, E, F, C
print "DFS: " + listJoin(dfs("A"), ", ");

print "";
// CHECK: === Shortest paths ===
print "=== Shortest paths ===";
// CHECK: A -> D: A, B, D
print "A -> D: " + listJoin(shortestPath("A", "D"), ", ");
// CHECK: A -> F: A, C, F
print "A -> F: " + listJoin(shortestPath("A", "F"), ", ");
// CHECK: D -> F: D, B, E, F
print "D -> F: " + listJoin(shortestPath("D", "F"), ", ");
// CHECK: A -> A: A
print "A -> A: " + listJoin(shortestPath("A", "A"), ", ");

// -----------------------------------------------------------------------
// The graph as a container — membership, length, and node iteration.
// -----------------------------------------------------------------------

// CHECK: === Graph as a container ===
print "";
print "=== Graph as a container ===";
// CHECK: nodes = 6
print "nodes = " + str(len(g));
// CHECK: "A" in graph = true
print "\"A\" in graph = " + str("A" in g);
// CHECK: "Z" in graph = false
print "\"Z\" in graph = " + str("Z" in g);
// CHECK: neighbours of B = A, D, E
print "neighbours of B = " + listJoin(g["B"], ", ");
var names = "";
for (var name in g) names = names + name;
// CHECK: node order = ABCDEF
print "node order = " + names;
