// enum_result.lox — Result/Option idiom using enum + constructor patterns.

enum Result { Ok(value) Err(msg) }
enum Option { Some(v) None }

fun safe_div(a, b) {
    if (b == 0) {
        return Result.Err("division by zero");
    }
    return Result.Ok(a / b);
}

fun show_result(r) {
    print match r {
        case Result.Ok(v)  => "ok: " + str(v)
        case Result.Err(m) => "err: " + m
    };
}

// CHECK: ok: 5
show_result(safe_div(10, 2));
// CHECK: err: division by zero
show_result(safe_div(1, 0));

fun find_first(lst, pred) {
    var i = 0;
    while (i < len(lst)) {
        if (pred(lst[i])) {
            return Option.Some(lst[i]);
        }
        i = i + 1;
    }
    return Option.None();
}

fun is_even(x) { return x % 2 == 0; }

var nums = [1, 3, 5, 4, 7];
var result = find_first(nums, is_even);

// CHECK: found even: 4
print match result {
    case Option.Some(v) => "found even: " + str(v)
    case Option.None    => "no even number"
};
