// A catch-bound value matched with only wildcard arms (no constructor
// pattern), one of them guarded, followed by a sibling try/catch. This
// exercises compileMatchBody's ident-pattern path (no literal/tag miss
// jump) rather than the constructor-pattern path the other match-in-catch
// regressions cover.
//
// The try body throws through an if/else rather than a bare `throw`: an
// if/else re-anchors the compiler's own operand-height counter on exit, so
// this shape does not rely on an unrelated, unbalanced counter elsewhere
// happening to cancel out the defect under test.

fun f() {
    try {
        if (true) { throw "boom"; } else { throw "unused"; }
    } catch (e) {
        var described = match e {
            case _ if e == "boom" => "matched boom"
            case _                => "matched something else"
        };
        print described;
    }
    try { throw "sibling-fault"; }
    catch (e2) { print "sibling caught: " + e2; }
}
f();

// CHECK: matched boom
// CHECK: sibling caught: sibling-fault
