// data_pipeline.lox — Read names from a file, prepend line numbers, write result.
//
// Demonstrates: open() "r" and "w" modes, readline(), writeline(), read-transform-write.

var INPUT  = "examples/data_pipeline.input";
var OUTPUT = "examples/data_pipeline.output";

// Transform: read input, write numbered output. Defers are function-scoped,
// so they fire when this function returns, ensuring the output file is fully
// flushed before main() reopens it for reading.
fun transform() {
    var fin  = open(INPUT,  "r");
    defer fin.close();
    var fout = open(OUTPUT, "w");
    defer fout.close();
    var n = 1;
    var line = fin.readline();
    while (line != nil) {
        fout.writeline(str(n) + ". " + line);
        n = n + 1;
        line = fin.readline();
    }
}

// Verify: read and print the output file.
fun verify() {
    print "=== Data Pipeline ===";
    var f = open(OUTPUT, "r");
    defer f.close();
    var line = f.readline();
    while (line != nil) {
        print line;
        line = f.readline();
    }
}

fun main() {
    transform();
    verify();
}

main();
// CHECK: === Data Pipeline ===
// CHECK: 1. Alice
// CHECK: 2. Bob
// CHECK: 3. Carol
// CHECK: 4. Dave
// CHECK: 5. Eve
