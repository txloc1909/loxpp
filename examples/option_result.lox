// option_result.lox - an Option/Result library in user space.
//
// Option and Result are plain enums. The combinators unwrapOr, andThen, and
// map are free functions, because enums take constructors only, not methods
// (enum methods: #557). Each combinator consumes its value with match.
//
// The last section dogfoods the library: a small program parses a list of
// strings into positive numbers and sums the ones that parsed, with no
// exception and no sentinel value.

enum Option { Some(v) None }
enum Result { Ok(value) Err(msg) }

// --- Option combinators -------------------------------------------------

// Return the contained value, or a fallback when the Option is empty.
fun unwrapOr(opt, fallback) {
    return match opt {
        case Option.Some(v) => v
        case Option.None    => fallback
    };
}

// Apply f to the contained value; f itself returns an Option. This is the
// monadic bind, so chained lookups stop at the first None.
fun andThen(opt, f) {
    return match opt {
        case Option.Some(v) => f(v)
        case Option.None    => Option.None()
    };
}

// Apply f to the contained value and re-wrap it, leaving None untouched.
fun map(opt, f) {
    return match opt {
        case Option.Some(v) => Option.Some(f(v))
        case Option.None    => Option.None()
    };
}

// --- Option combinators, exercised directly -----------------------------

fun double(x) { return x * 2; }

// Render an Option for printing. A match is used here through a function call,
// not inline as `... + match {...}`: a match expression fed straight into `+`
// is a known cross-backend gap (docs/reference/bytecode-translation-problems.md), so
// the result goes through a helper, which every backend compiles.
fun showOpt(o) {
    return match o {
        case Option.Some(v) => "Some(" + str(v) + ")"
        case Option.None    => "None"
    };
}

// CHECK: unwrapOr(Some(7), 0) = 7
print "unwrapOr(Some(7), 0) = " + str(unwrapOr(Option.Some(7), 0));
// CHECK: unwrapOr(None, 0) = 0
print "unwrapOr(None, 0) = " + str(unwrapOr(Option.None(), 0));

// CHECK: map(double, Some(21)) = Some(42)
print "map(double, Some(21)) = " + showOpt(map(Option.Some(21), double));
// CHECK: map(double, None) = None
print "map(double, None) = " + showOpt(map(Option.None(), double));

// andThen short-circuits on None: halve only succeeds on an even number.
fun halveEven(x) {
    if (x % 2 == 0) return Option.Some(x / 2);
    return Option.None();
}

// CHECK: andThen(Some(8), halveEven) = 4
print "andThen(Some(8), halveEven) = " + str(unwrapOr(andThen(Option.Some(8), halveEven), -1));
// CHECK: andThen(Some(7), halveEven) = -1
print "andThen(Some(7), halveEven) = " + str(unwrapOr(andThen(Option.Some(7), halveEven), -1));

// --- Result, and a bridge from Result to Option -------------------------

// Parse a decimal String into a positive Number, or report why it failed.
fun parsePositive(s) {
    if (len(s) == 0) return Result.Err("empty");
    var n = 0;
    for (var c in s) {
        var code = ord(c);
        if (code < ord("0") or code > ord("9")) return Result.Err("not a digit: " + c);
        n = n * 10 + (code - ord("0"));
    }
    if (n == 0) return Result.Err("not positive");
    return Result.Ok(n);
}

fun describe(r) {
    return match r {
        case Result.Ok(value) => "ok " + str(value)
        case Result.Err(msg)  => "err " + msg
    };
}

// CHECK: parse '42' -> ok 42
print "parse '42' -> " + describe(parsePositive("42"));
// CHECK: parse '' -> err empty
print "parse '' -> " + describe(parsePositive(""));
// CHECK: parse '4x' -> err not a digit: x
print "parse '4x' -> " + describe(parsePositive("4x"));
// CHECK: parse '0' -> err not positive
print "parse '0' -> " + describe(parsePositive("0"));

// Drop the error detail: a successful Result becomes Some, a failure None.
fun resultToOption(r) {
    return match r {
        case Result.Ok(value) => Option.Some(value)
        case Result.Err(_)    => Option.None()
    };
}

// --- Dogfood: sum the inputs that parse as positive numbers -------------

var inputs = ["10", "oops", "20", "", "12"];
var total = 0;
var kept = 0;
for (var raw in inputs) {
    // map transforms the parsed Option through double, then unwrapOr supplies
    // 0 for anything that did not parse - one pipeline, no branching here.
    var parsed = resultToOption(parsePositive(raw));
    var contribution = unwrapOr(map(parsed, double), 0);
    total = total + contribution;
    if (contribution > 0) kept = kept + 1;
}

// CHECK: kept 3 of 5 inputs
print "kept " + str(kept) + " of " + str(len(inputs)) + " inputs";
// CHECK: doubled total = 84
print "doubled total = " + str(total);
