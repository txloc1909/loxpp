// A `return` taken from inside an open try must not leave a stale handler
// behind. Here g's try never reaches its own POP_HANDLER (the return skips
// it), and h's try/catch runs afterward at the same call-frame depth. h's
// throw must be caught by h's own handler, not by g's leftover one.
fun g(shouldReturn) {
    try {
        if (shouldReturn) { return "early"; }
    } catch (e) { print "g caught: " + e; }
}

fun h() {
    try {
        throw "h-fault";
    } catch (e) {
        print "h caught: " + e;
    }
}

print g(true);
h();
print "done";
// CHECK: early
// CHECK: h caught: h-fault
// CHECK: done
