// Regression: a single try/catch with no sibling at all, whose catch body
// is the LAST code the function ever runs and ends in `return`. The catch
// region must still end where the handler does even though no CFG label
// follows it, so the handler body is not spilled outside the guarded
// region. No sibling try/catch or dead-code shape is needed to trigger
// this, unlike the other try_catch_*_terminal_* regressions.

fun f() {
    try {
        throw "x";
    } catch (e) {
        print "caught: " + e;
        return "early";
    }
}
print f();

// CHECK: caught: x
// CHECK: early
