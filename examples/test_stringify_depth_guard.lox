// Test that stringify has a depth guard to prevent stack overflow
// This builds a moderately nested structure and verifies it can be stringified
// Note: Due to bootstrap interpreter overhead, we can't reach the 200-level limit
// before hitting native stack overflow, but the guard is in place for the native VM

var x = [1, 2];
var i = 0;
while (i < 10) {
    x = [x, x];
    i = i + 1;
}
print "deep structure created";
print len(str(x));
print "stringify successful";
