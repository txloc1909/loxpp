// A large stream moved in parts, so the other tasks of the worker get a turn
// during the transfer.
//
// A call of class suspends reaches its wait only when the wait is not over at
// the call (spec/04-semantics.md, Suspend Points). While a connection keeps
// up, a read or a write never reaches a wait, so the call runs as one stretch
// and keeps the worker: the other tasks of the worker get no turn until the
// call returns. A program that needs them alive during a large transfer moves
// the stream itself, in parts, and yields between the parts. `yield` is a
// suspend point the program names, so the turn is the program's choice and not
// a race with the peer.
//
// Here the whole bulk is in the socket before the reader starts, so the reader
// never has to wait for the network: nothing but the `yield` in `readParts`
// can give the ticker a turn. Take that `yield` out and the last line of the
// output says false.
//
// A server reads a bulk string this way when it must answer other clients
// meanwhile. A single `conn.read_bytes(n)` does the same work with no turns.
// `your_program.sh` of a Codecrafters example is the place this pattern ends
// up in (#1172).
// STATUS: ok
// TIMEOUT: 20
// CHECK: the client wrote 32768 bytes
// CHECK: the reader got 32768 bytes
// CHECK: the ticker ran during the read: true

var total = 32768; // fits in the buffers of one connection, so the write does
var part = 4096;   // not wait, and the parts come from the socket, not the peer

var srv = listen("127.0.0.1", 0);
var peer = connect("127.0.0.1", srv.port());
var conn = srv.accept();
var me = task.self();

var got = 0;
var tickerTurns = 0;
var ticksDuringRead = false;

// Moves `n` bytes of the stream in parts, and yields after each part. The
// result is the same as `conn.read_bytes(n)`; the turns are the difference.
fun readParts(n) {
    var out = "";
    while (len(out) < n) {
        var s = conn.read_some(n - len(out));
        if (s == "") break;
        out = out + s;
        yield;
    }
    return out;
}

fun reader() {
    var before = tickerTurns;
    got = len(readParts(total));
    ticksDuringRead = before < tickerTurns;
    task.send(me, "read");
}

// Always ready, so it runs at every turn the reader gives away.
fun ticker() {
    while (true) {
        tickerTurns = tickerTurns + 1;
        yield;
    }
}

var bulk = "abcdefgh";
for (var i = 0; i < 12; i = i + 1) bulk = bulk + bulk;
peer.write(bulk);

task.spawn(ticker);
task.spawn(reader);
task.receive();
print "the client wrote " + str(total) + " bytes";
print "the reader got " + str(got) + " bytes";
print "the ticker ran during the read: " + str(ticksDuringRead);

conn.close();
peer.close();
srv.close();
