// or_pattern_demo.lox — or-patterns: one arm, multiple constructor alternatives.
//
// Demonstrates:
//   - Zero-binding or-pattern: several constructors share the same body
//   - Binding or-pattern: constructors with the same field name
//   - Guard on an or-pattern
//   - Three-alternative or-pattern
//   - Or-pattern arms contributing to exhaustiveness

// ---------------------------------------------------------------------------
// Zero-binding or-pattern
// ---------------------------------------------------------------------------

// A traffic light where Red and Amber both mean "stop".
enum Light { Red Amber Green }

fun must_stop(light) {
    return match light {
        case Light.Red or Light.Amber => true
        case Light.Green        => false
    };
}

// CHECK: must_stop: true true false
print "must_stop: " + str(must_stop(Light.Red())) + " " +
                      str(must_stop(Light.Amber())) + " " +
                      str(must_stop(Light.Green()));

// ---------------------------------------------------------------------------
// Binding or-pattern: two constructors, same field name
// ---------------------------------------------------------------------------

// Control signals: Stop and SlowDown both carry a reason; Go carries nothing.
enum Signal { Stop(reason) SlowDown(reason) Go }

fun describe(s) {
    return match s {
        case Signal.Stop(reason) or Signal.SlowDown(reason) => "caution: " + reason
        case Signal.Go                               => "proceed"
    };
}

// CHECK: caution: red light
print describe(Signal.Stop("red light"));
// CHECK: caution: school zone
print describe(Signal.SlowDown("school zone"));
// CHECK: proceed
print describe(Signal.Go());

// ---------------------------------------------------------------------------
// Guard on an or-pattern
// ---------------------------------------------------------------------------

// Only mark as "urgent" if the reason begins with "!".
fun urgency(s) {
    return match s {
        case Signal.Stop(reason) or Signal.SlowDown(reason) if "!" in reason => "URGENT: " + reason
        case Signal.Stop(reason) or Signal.SlowDown(reason)                  => "normal: " + reason
        case Signal.Go                                                => "clear"
    };
}

// CHECK: URGENT: !emergency vehicle
print urgency(Signal.Stop("!emergency vehicle"));
// CHECK: normal: low visibility
print urgency(Signal.SlowDown("low visibility"));
// CHECK: clear
print urgency(Signal.Go());

// ---------------------------------------------------------------------------
// Three-alternative or-pattern
// ---------------------------------------------------------------------------

// Cardinal directions: group into horizontal vs vertical movement.
enum Dir { North South East West }

fun axis(d) {
    return match d {
        case Dir.North or Dir.South            => "vertical"
        case Dir.East or Dir.West              => "horizontal"
    };
}

// CHECK: vertical vertical horizontal horizontal
print axis(Dir.North()) + " " + axis(Dir.South()) + " " +
      axis(Dir.East())  + " " + axis(Dir.West());

// Three directions in one arm:
fun near_north(d) {
    return match d {
        case Dir.North or Dir.East or Dir.West => true
        case Dir.South                 => false
    };
}

// CHECK: true false true true
print str(near_north(Dir.North())) + " " + str(near_north(Dir.South())) + " " +
      str(near_north(Dir.East()))  + " " + str(near_north(Dir.West()));
