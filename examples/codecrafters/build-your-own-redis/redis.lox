// redis.lox — Codecrafters "Build your own Redis" in pure Lox++.
//
//   your_program.sh [--port <n>]
//
// Each connection runs as two tasks on the one worker:
//
//   reader   owns the read side of the socket. It parses RESP and sends one
//            Msg.Cmd per command to the session task.
//   session  owns the write side. It takes messages from its mailbox, runs
//            each command, and writes the reply.
//
// A session must also take messages from other tasks while its client sends
// nothing (a blocked list pop, a published message, a replica ack). A task
// that waits in readline cannot receive, so reading and replying are two
// tasks. Only the session writes the socket: two tasks that wait on one side
// of a socket raise BusyError.
//
// The keyspace is a set of global Maps that every task of the worker shares.
// The code that runs one command has no suspend point: every write to a
// socket comes after the command. So each command is atomic, as in Redis.

// ===========================================================================
// String helpers (the stdlib has no split/upper/trim built in).
// ===========================================================================

// A command does not suspend, so a helper whose time grows with the square
// of its input lets one client stop every other client. These helpers stay
// linear: they slice, and do not grow a String one byte at a time on long
// input.

// The longest command name or option that upper() converts. Every name
// and option is shorter, so a longer word matches none, and upper() gives
// it back unchanged.
var MAX_KEYWORD = 32;

fun lower(s) {
    if (len(s) > MAX_KEYWORD) {
        return s;
    }
    var out = "";
    var i = 0;
    while (i < len(s)) {
        var c = ord(s[i]);
        if (c >= 65 and c <= 90) {
            out = out + chr(c + 32);
        } else {
            out = out + s[i];
        }
        i = i + 1;
    }
    return out;
}

fun upper(s) {
    if (len(s) > MAX_KEYWORD) {
        return s;
    }
    var out = "";
    var i = 0;
    while (i < len(s)) {
        var c = ord(s[i]);
        if (c >= 97 and c <= 122) {
            out = out + chr(c - 32);
        } else {
            out = out + s[i];
        }
        i = i + 1;
    }
    return out;
}

// readline() strips the '\n' but keeps the '\r'.
fun trimCR(s) {
    if (len(s) > 0 and s[len(s) - 1] == "\r") {
        return s[0:len(s) - 1];
    }
    return s;
}

// Returns the integer value of s as a Number, or nil. As in Redis, s is
// "0", or an optional '-' and digits with no leading zero. It has at most 15
// digits, so the value is exact in a Number; Redis allows the full 64-bit
// range.
fun parseInteger(s) {
    var i = 0;
    var negative = false;
    if (len(s) > 0 and s[0] == "-") {
        negative = true;
        i = 1;
    }
    if (i >= len(s) or len(s) - i > 15) {
        return nil;
    }
    if (s[i] == "0" and (len(s) - i > 1 or negative)) {
        return nil;
    }
    var n = 0;
    while (i < len(s)) {
        var c = ord(s[i]);
        if (c < 48 or c > 57) {
            return nil;
        }
        n = n * 10 + (c - 48);
        i = i + 1;
    }
    if (negative) {
        return -n;
    }
    return n;
}

// Splits an inline command on runs of spaces and tabs.
fun splitWords(s) {
    var words = [];
    var start = 0;
    var i = 0;
    while (i <= len(s)) {
        if (i == len(s) or s[i] == " " or s[i] == "\t") {
            if (i > start) {
                words.append(s[start:i]);
            }
            start = i + 1;
        }
        i = i + 1;
    }
    return words;
}

// ===========================================================================
// Faults
//
// A catch block can get any value: an Error from the runtime, or a value of
// a throw. A property read on a value that is not an Instance or an Error is
// a halting fault, also inside a catch block, so these helpers check the
// kind of the value first.
// ===========================================================================

class ProtocolError {
    init(message) {
        this.kind = "ProtocolError";
        this.message = message;
    }
}

fun faultKind(e) {
    if (type(e) == "Error") {
        return e.kind;
    }
    if (type(e) == "Instance" and hasField(e, "kind")) {
        return e.kind;
    }
    return type(e);
}

fun faultText(e) {
    if (type(e) == "Error") {
        return e.message;
    }
    if (type(e) == "Instance" and hasField(e, "message")) {
        return str(e.message);
    }
    return str(e);
}

// ===========================================================================
// RESP encoding
// ===========================================================================

fun simple(s) {
    return "+" + s + "\r\n";
}

fun errorReply(s) {
    return "-" + s + "\r\n";
}

fun bulk(s) {
    return "$" + str(len(s)) + "\r\n" + s + "\r\n";
}

var NULL_BULK = "$-1\r\n";
var NULL_ARRAY = "*-1\r\n";
var NOT_INTEGER = "-ERR value is not an integer or out of range\r\n";

fun integerReply(n) {
    return ":" + str(n) + "\r\n";
}

// Joins parts[lo:hi] by halves, so each byte is copied about log2(n) times;
// a left-to-right join would copy it n times.
fun joinRange(parts, lo, hi) {
    if (hi - lo == 0) {
        return "";
    }
    if (hi - lo == 1) {
        return parts[lo];
    }
    var mid = lo + (hi - lo - (hi - lo) % 2) / 2;
    return joinRange(parts, lo, mid) + joinRange(parts, mid, hi);
}

// items holds replies that are already encoded.
fun arrayReply(items) {
    return "*" + str(len(items)) + "\r\n" + joinRange(items, 0, len(items));
}

// A reply of many bulks: the session encodes and writes it in steps of
// ELEMENTS_PER_YIELD elements and yields between the steps. The elements are
// the elements of rev from last to first, then the elements of fwd in order.
// rev and fwd are new Lists that the command took from the keyspace in one
// step, so the command stays atomic, and a long list does not stop the other
// clients while its reply is encoded.
class Bulks {
    init(rev, fwd) {
        this.rev = rev;
        this.fwd = fwd;
    }
}

// A reply of arrays of stream entries: head, then for each i the entries
// froms[i] to tos[i] - 1 of streams[i], under the name keys[i] (XREAD) or
// with no name (XRANGE, keys[i] is nil). A Stream only grows at its end, so
// these entries do not change after the command: the command stays atomic
// with no copy, and the session encodes and writes the entries in steps and
// yields between the steps (writeSegments).
class Segments {
    init(head) {
        this.head = head;
        this.keys = [];
        this.streams = [];
        this.froms = [];
        this.tos = [];
    }

    add(key, stream, from, to) {
        this.keys.append(key);
        this.streams.append(stream);
        this.froms.append(from);
        this.tos.append(to);
    }
}

fun bulkArray(strings) {
    var items = [];
    for (var s in strings) {
        items.append(bulk(s));
    }
    return arrayReply(items);
}

var WRONGTYPE = "-WRONGTYPE Operation against a key holding the wrong kind of value\r\n";

fun wrongArgs(name) {
    return errorReply("ERR wrong number of arguments for '" + name + "' command");
}

// ===========================================================================
// Messages between tasks
//
// A List is not a message (spec/03-types.md, Messages), also between tasks of
// one worker, so the arguments of a command travel as an enum list.
// ===========================================================================

enum Args { Cons(head, tail) Empty }
// Reader to session: Cmd, Fail, Closed. Fail(text) carries a protocol error:
// the session replies with it and ends the connection, as Redis does.
// Session to reader: Credit after each command it has done, Blocked when it
// starts to wait in BLPOP, and Stop when it ends.
// Served(key, value), from a pusher to a session that waits in BLPOP,
// hands it a popped element. Ready, from XADD to a session that waits in
// XREAD BLOCK, says that its reply is in its Waiter.
enum Msg { Cmd(args, nbytes) Fail(text) Closed Credit Blocked Stop Served(key, value) Ready }

// Both run over up to ARRAY_MAX arguments, so they yield as the reader does
// (rule 2 of the README). toArgs runs in the reader and fromArgs in the
// session before the command starts, so the command stays atomic.
fun toArgs(list) {
    var out = Args.Empty();
    var i = len(list) - 1;
    while (i >= 0) {
        out = Args.Cons(list[i], out);
        i = i - 1;
        if (i > 0 and i % ELEMENTS_PER_YIELD == 0) {
            yield nil;
        }
    }
    return out;
}

// Yields after each ELEMENTS_PER_YIELD-th element. Returns false, so that a
// match arm can call it as its last expression.
fun yieldEvery(count) {
    if (count % ELEMENTS_PER_YIELD == 0) {
        yield nil;
    }
    return false;
}

fun fromArgs(args) {
    var out = [];
    var rest = args;
    var done = false;
    while (!done) {
        done = match rest {
            case Args.Cons(head, tail) => {
                out.append(head);
                rest = tail;
                yieldEvery(len(out))
            }
            case Args.Empty => true
        };
    }
    return out;
}

// ===========================================================================
// Keyspace
// ===========================================================================

// kind is "string", "list" or "stream", which is also the TYPE reply. A
// list key holds a Deque, and an empty list is never stored: the key goes
// away with its last element, as in Redis. A stream key holds a Stream.
class Entry {
    init(kind, value, expiresAt) {
        this.kind = kind;
        this.value = value;
        // Milliseconds since the epoch, or nil for a key with no expiry.
        this.expiresAt = expiresAt;
    }
}

var store = {};

fun nowMs() {
    return time() * 1000;
}

// Returns the live entry of key, or nil. An expired key is removed here, on
// access, as Redis does lazily.
fun lookup(key) {
    var entry = store[key];
    if (entry == nil) {
        return nil;
    }
    if (entry.expiresAt != nil and nowMs() >= entry.expiresAt) {
        store.del(key);
        return nil;
    }
    return entry;
}

// ===========================================================================
// Commands
// ===========================================================================

// Redis reads every option before it checks a number, so a syntax error
// comes before an integer error.
fun cmdSet(argv) {
    if (len(argv) < 3) {
        return wrongArgs("set");
    }
    var key = argv[1];
    var expiryUnit = nil;
    var expiryText = nil;
    var keepTtl = false;
    var condition = nil;
    var returnOld = false;
    var i = 3;
    while (i < len(argv)) {
        var opt = upper(argv[i]);
        if ((opt == "PX" or opt == "EX" or opt == "PXAT" or opt == "EXAT")
            and i + 1 < len(argv) and expiryUnit == nil and !keepTtl) {
            expiryUnit = opt;
            expiryText = argv[i + 1];
            i = i + 2;
        } else if (opt == "KEEPTTL" and expiryUnit == nil) {
            keepTtl = true;
            i = i + 1;
        } else if ((opt == "NX" or opt == "XX") and (condition == nil or condition == opt)) {
            condition = opt;
            i = i + 1;
        } else if (opt == "GET") {
            returnOld = true;
            i = i + 1;
        } else {
            return errorReply("ERR syntax error");
        }
    }
    var expiresAt = nil;
    if (expiryUnit != nil) {
        var n = parseInteger(expiryText);
        if (n == nil) {
            return NOT_INTEGER;
        }
        if (n <= 0) {
            return errorReply("ERR invalid expire time in 'set' command");
        }
        if (expiryUnit == "EX" or expiryUnit == "EXAT") {
            n = n * 1000;
        }
        expiresAt = n;
        if (expiryUnit == "PX" or expiryUnit == "EX") {
            expiresAt = nowMs() + n;
        }
    }
    var old = lookup(key);
    if (returnOld and old != nil and old.kind != "string") {
        return WRONGTYPE;
    }
    var reply = simple("OK");
    if (returnOld) {
        reply = NULL_BULK;
        if (old != nil) {
            reply = bulk(old.value);
        }
    }
    if ((condition == "NX" and old != nil) or (condition == "XX" and old == nil)) {
        if (returnOld) {
            return reply;
        }
        return NULL_BULK;
    }
    if (keepTtl and old != nil) {
        expiresAt = old.expiresAt;
    }
    store[key] = Entry("string", argv[2], expiresAt);
    return reply;
}

// INFO has one section so far. A section name that is not known adds
// nothing, as in Redis.
fun cmdInfo(argv) {
    var clients = len(argv) == 1;
    var i = 1;
    while (i < len(argv)) {
        var want = lower(argv[i]);
        if (want == "all" or want == "default" or want == "everything"
            or want == "clients") {
            clients = true;
        }
        i = i + 1;
    }
    var out = "";
    if (clients) {
        out = out + "# Clients\r\nconnected_clients:" + str(connectedClients) + "\r\n";
    }
    return bulk(out);
}

fun cmdGet(argv) {
    if (len(argv) != 2) {
        return wrongArgs("get");
    }
    var entry = lookup(argv[1]);
    if (entry == nil) {
        return NULL_BULK;
    }
    if (entry.kind != "string") {
        return WRONGTYPE;
    }
    return bulk(entry.value);
}

// The text of Redis 7.0: the name and the start of the arguments, each cut
// so that the message stays short.
fun unknownCommand(argv) {
    var shown = "";
    var i = 1;
    while (i < len(argv) and len(shown) < 128) {
        shown = shown + "'" + argv[i][0:128 - len(shown)] + "' ";
        i = i + 1;
    }
    return errorReply("ERR unknown command '" + argv[0][0:128]
                      + "', with args beginning with: " + shown);
}


// ===========================================================================
// Lists
// ===========================================================================

// A double-ended queue over two Lists. front[0:live] holds the elements
// pushed to the left, last pushed at the end, so the first element is
// front[live - 1]; the slots after live are free. back[head:len(back)] holds
// the others in order. A push fills a free slot or appends, so no push copies
// the queue. A pop moves live or head, so a pop of k elements costs one slice
// of k. When the free slots outnumber the elements of a List, one slice drops
// them; it copies fewer elements than the pops that freed the slots. So each
// push and pop costs a constant time on average, and a long LPUSH, RPUSH or
// LPOP series stays linear.
class Deque {
    init() {
        this.front = [];
        this.live = 0;
        this.back = [];
        this.head = 0;
    }

    size() {
        return this.live + len(this.back) - this.head;
    }

    at(i) {
        if (i < this.live) {
            return this.front[this.live - 1 - i];
        }
        return this.back[this.head + i - this.live];
    }

    // The elements start..stop-1 (0 <= start <= stop <= size()), as a Bulks
    // reply, with one slice of each List.
    range(start, stop) {
        var f = this.live;
        var rev = [];
        if (start < f) {
            var end = stop;
            if (end > f) {
                end = f;
            }
            rev = this.front[f - end:f - start];
        }
        var fwd = [];
        if (stop > f) {
            var first = start;
            if (first < f) {
                first = f;
            }
            fwd = this.back[this.head + first - f:this.head + stop - f];
        }
        return Bulks(rev, fwd);
    }

    pushRight(v) {
        this.back.append(v);
    }

    pushLeft(v) {
        if (this.live < len(this.front)) {
            this.front[this.live] = v;
        } else {
            this.front.append(v);
        }
        this.live = this.live + 1;
    }

    // Removes the first k elements (k <= size()) and returns them as a
    // Bulks reply. The cost grows with k, not with the size of the queue.
    takeLeft(k) {
        var reply = this.range(0, k);
        this.live = this.live - len(reply.rev);
        this.head = this.head + len(reply.fwd);
        this.compact();
        return reply;
    }

    popLeft() {
        var v = nil;
        if (this.live > 0) {
            this.live = this.live - 1;
            v = this.front[this.live];
            this.front[this.live] = nil;
        } else {
            v = this.back[this.head];
            this.back[this.head] = nil;
            this.head = this.head + 1;
        }
        this.compact();
        return v;
    }

    compact() {
        if (len(this.front) > 32 and this.live * 2 < len(this.front)) {
            this.front = this.front[0:this.live];
        }
        if (this.head > 32 and this.head * 2 > len(this.back)) {
            this.back = this.back[this.head:len(this.back)];
            this.head = 0;
        }
    }
}

// A session that waits in BLPOP. active turns false when the waiter is
// served, times out, or its client goes away. servedBy is the key whose
// pusher served it: that queue already counted it out.
// For XREAD BLOCK, read is its StreamRead, and XADD puts the reply in
// ready before it sends Msg.Ready.
class Waiter {
    init(handle, read) {
        this.handle = handle;
        this.active = true;
        this.servedBy = nil;
        this.read = read;
        this.ready = nil;
    }
}

// The waiters of one key, oldest first: items[head:len(items)]. A waiter
// that is no longer active stays until a pusher or a compaction removes it.
// live counts the active ones: when the queue holds more than twice that, a
// compaction drops the others, so many waits that time out do not grow it
// without bound. A key with one waiter maps to the Waiter itself, and gets
// a WaitQueue at the second waiter, because BLPOP on many keys joins all of
// them in one step.
class WaitQueue {
    init(first, second) {
        this.items = [first, second];
        this.head = 0;
        this.live = 2;
    }

    size() {
        return len(this.items) - this.head;
    }

    // Adds w, and returns false when w is already the newest waiter: a
    // BLPOP that names a key twice waits in its queue once.
    add(w) {
        if (this.size() > 0 and this.items[len(this.items) - 1] == w) {
            return false;
        }
        this.items.append(w);
        this.live = this.live + 1;
        return true;
    }

    // Called once for each waiter that leaves without a pusher.
    left() {
        this.live = this.live - 1;
        if (this.size() > 2 * this.live + 16) {
            var kept = [];
            for (var w in this.items[this.head:len(this.items)]) {
                if (w.active) {
                    kept.append(w);
                }
            }
            this.items = kept;
            this.head = 0;
        }
    }

    next() {
        var w = this.items[this.head];
        this.items[this.head] = nil;
        this.head = this.head + 1;
        if (this.head > 32 and this.head * 2 > len(this.items)) {
            this.items = this.items[this.head:len(this.items)];
            this.head = 0;
        }
        return w;
    }

    // Returns the oldest active waiter and removes it, or nil.
    takeOldest() {
        while (this.size() > 0) {
            var w = this.next();
            if (w.active) {
                this.live = this.live - 1;
                return w;
            }
        }
        return nil;
    }
}

// key -> Waiter or WaitQueue: the sessions in BLPOP.
var waiters = {};

// key -> Waiter or WaitQueue: the sessions in XREAD BLOCK.
var readers = {};

// Returns the list entry of key, nil when the key is missing, or false when
// the key holds another kind.
fun listEntry(key) {
    var entry = lookup(key);
    if (entry == nil) {
        return nil;
    }
    if (entry.kind != "list") {
        return false;
    }
    return entry;
}

fun newList(key) {
    var entry = Entry("list", Deque(), nil);
    store[key] = entry;
    return entry;
}

fun popLeft(key, entry) {
    var v = entry.value.popLeft();
    if (entry.value.size() == 0) {
        store.del(key);
    }
    return v;
}

// Hands elements of key to the oldest waiters, while both remain. It runs at
// the end of a push, after the push computed its reply, so the pusher sees
// the length before any pop, as in Redis.
fun serveWaiters(key) {
    while (true) {
        var entry = listEntry(key);
        if (entry == nil or entry == false) {
            break;
        }
        var w = takeWaiter(waiters, key);
        if (w == nil) {
            break;
        }
        var value = popLeft(key, entry);
        w.active = false;
        w.servedBy = key;
        try {
            task.send(w.handle, Msg.Served(key, value));
        } catch (e) {
            // The waiter's task ended without leaving the queue: give the
            // element back.
            var back = listEntry(key);
            if (back == nil) {
                back = newList(key);
            }
            back.value.pushLeft(value);
        }
    }
}

fun isWaiter(x) {
    return hasField(x, "handle");
}

// Removes the oldest active waiter of key in queues (waiters or readers)
// and returns it, or nil.
fun takeWaiter(queues, key) {
    var queue = queues[key];
    if (queue == nil) {
        return nil;
    }
    if (isWaiter(queue)) {
        if (!queue.active) {
            // It is leaving, and removes the key itself.
            return nil;
        }
        queues.del(key);
        return queue;
    }
    var w = queue.takeOldest();
    if (queue.live == 0) {
        queues.del(key);
    }
    return w;
}

fun cmdPush(argv, left) {
    var name = "rpush";
    if (left) {
        name = "lpush";
    }
    if (len(argv) < 3) {
        return wrongArgs(name);
    }
    var entry = listEntry(argv[1]);
    if (entry == false) {
        return WRONGTYPE;
    }
    if (entry == nil) {
        entry = newList(argv[1]);
    }
    var i = 2;
    while (i < len(argv)) {
        if (left) {
            entry.value.pushLeft(argv[i]);
        } else {
            entry.value.pushRight(argv[i]);
        }
        i = i + 1;
    }
    var n = entry.value.size();
    serveWaiters(argv[1]);
    return integerReply(n);
}

fun cmdRpush(ctx, argv) {
    return cmdPush(argv, false);
}

fun cmdLpush(ctx, argv) {
    return cmdPush(argv, true);
}

fun cmdLlen(ctx, argv) {
    if (len(argv) != 2) {
        return wrongArgs("llen");
    }
    var entry = listEntry(argv[1]);
    if (entry == false) {
        return WRONGTYPE;
    }
    if (entry == nil) {
        return integerReply(0);
    }
    return integerReply(entry.value.size());
}

fun cmdLrange(ctx, argv) {
    if (len(argv) != 4) {
        return wrongArgs("lrange");
    }
    var start = parseInteger(argv[2]);
    var stop = parseInteger(argv[3]);
    if (start == nil or stop == nil) {
        return NOT_INTEGER;
    }
    var entry = listEntry(argv[1]);
    if (entry == false) {
        return WRONGTYPE;
    }
    if (entry == nil) {
        return arrayReply([]);
    }
    var n = entry.value.size();
    if (start < 0) {
        start = n + start;
    }
    if (stop < 0) {
        stop = n + stop;
    }
    if (start < 0) {
        start = 0;
    }
    if (stop >= n) {
        stop = n - 1;
    }
    if (start > stop) {
        return arrayReply([]);
    }
    return entry.value.range(start, stop + 1);
}

fun cmdLpop(ctx, argv) {
    if (len(argv) != 2 and len(argv) != 3) {
        return wrongArgs("lpop");
    }
    var count = nil;
    if (len(argv) == 3) {
        count = parseInteger(argv[2]);
        if (count == nil or count < 0) {
            return errorReply("ERR value is out of range, must be positive");
        }
    }
    var entry = listEntry(argv[1]);
    if (entry == false) {
        return WRONGTYPE;
    }
    if (entry == nil) {
        if (count == nil) {
            return NULL_BULK;
        }
        return NULL_ARRAY;
    }
    if (count == nil) {
        return bulk(popLeft(argv[1], entry));
    }
    if (count > entry.value.size()) {
        count = entry.value.size();
    }
    var reply = entry.value.takeLeft(count);
    if (entry.value.size() == 0) {
        store.del(argv[1]);
    }
    return reply;
}

fun isDigits(s) {
    if (len(s) == 0) {
        return false;
    }
    for (var c in s) {
        if (ord(c) < 48 or ord(c) > 57) {
            return false;
        }
    }
    return true;
}

// Returns the Number that s names, or nil. s is an optional sign, then
// digits with an optional fraction ("1", "0.5", ".5", "5."). float() of a
// String of another form is a halting fault, not a catchable one, so the
// form is checked first. Redis also accepts an exponent; this does not.
fun parseDecimal(s) {
    if (len(s) > 64) {
        return nil;
    }
    var body = s;
    var sign = "";
    if (len(body) > 0 and (body[0] == "-" or body[0] == "+")) {
        sign = body[0];
        body = body[1:len(body)];
    }
    if (body == "" or body == ".") {
        return nil;
    }
    var whole = body;
    var frac = nil;
    var i = 0;
    while (i < len(body)) {
        if (body[i] == ".") {
            whole = body[0:i];
            frac = body[i + 1:len(body)];
            break;
        }
        i = i + 1;
    }
    if (whole == "") {
        whole = "0";
    }
    if (frac == "") {
        frac = "0";
    }
    if (!isDigits(whole) or (frac != nil and !isDigits(frac))) {
        return nil;
    }
    if (frac == nil) {
        return float(sign + whole);
    }
    return float(sign + whole + "." + frac);
}

// Parses a BLPOP timeout in seconds. Returns a Number, or an error reply.
fun parseTimeout(s) {
    var t = parseDecimal(s);
    if (t == nil) {
        return errorReply("ERR timeout is not a float or out of range");
    }
    if (t < 0) {
        return errorReply("ERR timeout is negative");
    }
    return t;
}

// The result of a command that must wait: the session waits in queues
// (waiters or readers) on each key, then replies. timeout is in seconds, 0
// for no limit. read is the StreamRead of XREAD BLOCK, or nil.
class Block {
    init(queues, keys, timeout, read) {
        this.queues = queues;
        this.keys = keys;
        this.timeout = timeout;
        this.read = read;
    }
}

fun cmdBlpop(ctx, argv) {
    if (len(argv) < 3) {
        return wrongArgs("blpop");
    }
    var timeout = parseTimeout(argv[len(argv) - 1]);
    if (type(timeout) == "String") {
        return timeout;
    }
    var keys = argv[1:len(argv) - 1];
    for (var key in keys) {
        var entry = listEntry(key);
        if (entry == false) {
            return WRONGTYPE;
        }
        if (entry != nil) {
            return bulkArray([key, popLeft(key, entry)]);
        }
    }
    return Block(waiters, keys, timeout, nil);
}

fun isWake(msg) {
    return match msg {
        case Msg.Served(key, value) => true
        case Msg.Ready => true
        case Msg.Closed => true
        case _ => false
    };
}

// Counts the waiter out of the queue of each of its keys, except the queue
// whose pusher served it. The waiter is no longer active, so no pusher
// takes it while this yields between steps.
fun leaveQueues(queues, w, keys) {
    w.active = false;
    var i = 0;
    for (var key in keys) {
        var queue = queues[key];
        if (key != w.servedBy and queue != nil) {
            if (queue == w) {
                queues.del(key);
            } else if (!isWaiter(queue)) {
                queue.left();
                if (queue.live == 0) {
                    queues.del(key);
                }
            }
        }
        i = i + 1;
        if (i % ELEMENTS_PER_YIELD == 0) {
            yield nil;
        }
    }
}

// Puts w in the queue of each key, and returns the keys without repeats.
// It has no suspend point: a push between two keys would not see w in the
// queues that come after.
fun joinQueues(queues, w, keys) {
    var joined = [];
    for (var key in keys) {
        var queue = queues[key];
        if (queue == nil) {
            queues[key] = w;
            joined.append(key);
        } else if (queue == w) {
            // A repeated key: w already waits on it.
        } else if (isWaiter(queue)) {
            queues[key] = WaitQueue(queue, w);
            joined.append(key);
        } else if (queue.add(w)) {
            joined.append(key);
        }
    }
    return joined;
}

// Waits for a pusher (BLPOP) or a writer (XREAD BLOCK), or for the limit.
// Returns the reply, or nil when the client went away while the session
// waited.
fun waitForElement(conn, block) {
    var w = Waiter(task.self(), block.read);
    var queues = block.queues;
    var keys = joinQueues(queues, w, block.keys);
    var msg = nil;
    conn.blocked = true;
    try {
        // A reader that waits for credit must wake to read on.
        task.send(conn.reader, Msg.Blocked());
    } catch (ignored) {
        // The reader has ended; its Closed message ends this wait.
    }
    var timedOut = false;
    try {
        if (block.timeout == 0) {
            msg = task.receive_where(isWake);
        } else {
            msg = task.receive_where_within(isWake, block.timeout);
        }
    } catch (e) {
        if (faultKind(e) != "TimeoutError") {
            conn.blocked = false;
            leaveQueues(queues, w, keys);
            throw e;
        }
        timedOut = true;
    }
    conn.blocked = false;
    var served = msg;
    if (!isServed(msg) and w.servedBy != nil) {
        // A pusher served w after Closed came or after the limit, but
        // before this task ran: its message is in the mailbox.
        served = task.receive_where(isServed);
    }
    leaveQueues(queues, w, keys);
    if (!isServed(served)) {
        if (timedOut) {
            return NULL_ARRAY;
        }
        return nil;
    }
    var closed = !timedOut and !isServed(msg);
    return match served {
        case Msg.Served(key, value) => replyServed(conn, key, value, closed)
        case Msg.Ready => readyReply(w, closed)
        case _ => nil
    };
}

fun isServed(msg) {
    if (msg == nil) {
        return false;
    }
    return match msg {
        case Msg.Served(key, value) => true
        case Msg.Ready => true
        case _ => false
    };
}

// XREAD takes nothing from the stream, so a reply that the client cannot
// get is dropped.
fun readyReply(w, closed) {
    if (closed) {
        return nil;
    }
    return w.ready;
}

// Writes the element that a pusher handed to this client. When the client
// is gone, the element goes back to the head of its key, as if no pusher had
// taken it. Returns "" (the reply is written), or nil when the client is
// gone.
fun replyServed(conn, key, value, closed) {
    if (closed) {
        giveBack(key, value);
        return nil;
    }
    try {
        conn.sock.write(bulkArray([key, value]));
    } catch (e) {
        giveBack(key, value);
        throw e;
    }
    return "";
}

// Puts value back at the head of key and hands it to the next waiter. When
// a command replaced the key with another kind meanwhile, no list remains to
// take the value, and it is dropped.
fun giveBack(key, value) {
    var entry = listEntry(key);
    if (entry == false) {
        return;
    }
    if (entry == nil) {
        entry = newList(key);
    }
    entry.value.pushLeft(value);
    serveWaiters(key);
}

// ===========================================================================
// Streams
// ===========================================================================

// An entry ID. seq is nil when the text had no "-<seq>" part, and "*" for
// "<ms>-*".
class StreamId {
    init(ms, seq) {
        this.ms = ms;
        this.seq = seq;
    }
}

// Above any ID part that parseStreamId accepts (15 digits).
var MAX_ID_PART = 10000000000000000;

var INVALID_ID = "-ERR Invalid stream ID specified as stream command argument\r\n";
var ID_NOT_ABOVE_TOP = "-ERR The ID specified in XADD is equal or smaller than the target stream top item\r\n";
var ID_ZERO = "-ERR The ID specified in XADD must be greater than 0-0\r\n";
var SYNTAX_ERROR = "-ERR syntax error\r\n";
var ZERO_ID = StreamId(0, 0);

fun idText(ms, seq) {
    return str(ms) + "-" + str(seq);
}

// Parses "<ms>-<seq>" or "<ms>", and "<ms>-*" when star is true. Returns a
// StreamId, or nil when s is not an ID. Each part has at most 15 digits, so
// that it is exact in a Number; Redis allows the full 64-bit range. The
// length check comes first, so a long argument costs no loop.
fun parseStreamId(s, star) {
    if (len(s) == 0 or len(s) > 31) {
        return nil;
    }
    var dash = -1;
    var i = 0;
    while (i < len(s)) {
        if (s[i] == "-") {
            if (dash != -1) {
                return nil;
            }
            dash = i;
        }
        i = i + 1;
    }
    if (dash == -1) {
        if (!isDigits(s)) {
            return nil;
        }
        return idPart(s, nil);
    }
    var head = s[0:dash];
    var tail = s[dash + 1:len(s)];
    if (!isDigits(head)) {
        return nil;
    }
    if (star and tail == "*") {
        return idPart(head, "*");
    }
    if (!isDigits(tail)) {
        return nil;
    }
    var seq = parseInteger(tail);
    if (seq == nil) {
        return nil;
    }
    return idPart(head, seq);
}

fun idPart(digits, seq) {
    var ms = parseInteger(digits);
    if (ms == nil) {
        return nil;
    }
    return StreamId(ms, seq);
}

// The entries of a stream, oldest first, in three Lists of the same length:
// the two parts of each ID and the fields of each entry. XADD keeps the
// fields as one slice of its arguments, and a read keeps only the bounds of
// its entries, so neither costs more for an entry with more fields; the
// session encodes the reply in steps.
class Stream {
    init() {
        this.ms = [];
        this.seq = [];
        this.fields = [];
    }

    size() {
        return len(this.ms);
    }

    // The top ID; 0-0 for a stream with no entry.
    topMs() {
        if (this.size() == 0) {
            return 0;
        }
        return this.ms[this.size() - 1];
    }

    topSeq() {
        if (this.size() == 0) {
            return 0;
        }
        return this.seq[this.size() - 1];
    }

    // The index of the first entry whose ID is above ms-seq, or equal to it
    // when inclusive is true. A binary search: the IDs only grow.
    find(ms, seq, inclusive) {
        var lo = 0;
        var hi = this.size();
        while (lo < hi) {
            var mid = lo + (hi - lo - (hi - lo) % 2) / 2;
            var m = this.ms[mid];
            var q = this.seq[mid];
            var below = m < ms or (m == ms and q < seq);
            if (!inclusive and m == ms and q == seq) {
                below = true;
            }
            if (below) {
                lo = mid + 1;
            } else {
                hi = mid;
            }
        }
        return lo;
    }

    add(ms, seq, fields) {
        this.ms.append(ms);
        this.seq.append(seq);
        this.fields.append(fields);
    }

    // True when the stream has an entry above ms-seq.
    hasAbove(ms, seq) {
        var n = this.size();
        if (n == 0) {
            return false;
        }
        var top = this.ms[n - 1];
        return ms < top or (ms == top and seq < this.seq[n - 1]);
    }
}

// Returns the Stream of key, nil when the key is missing, or false when the
// key holds another kind.
fun streamEntry(key) {
    var entry = lookup(key);
    if (entry == nil) {
        return nil;
    }
    if (entry.kind != "stream") {
        return false;
    }
    return entry.value;
}

fun cmdType(ctx, argv) {
    if (len(argv) != 2) {
        return wrongArgs("type");
    }
    var entry = lookup(argv[1]);
    if (entry == nil) {
        return simple("none");
    }
    return simple(entry.kind);
}

// The ID of a new entry, from the ID argument of XADD and the top ID of the
// stream. Returns a StreamId, or an error reply.
fun nextStreamId(text, topMs, topSeq) {
    if (text == "*") {
        var now = nowMs();
        now = now - now % 1;
        if (now > topMs) {
            return StreamId(now, 0);
        }
        return StreamId(topMs, topSeq + 1);
    }
    var id = parseStreamId(text, true);
    if (id == nil) {
        return INVALID_ID;
    }
    if (id.seq == "*") {
        if (id.ms < topMs) {
            return ID_NOT_ABOVE_TOP;
        }
        if (id.ms == topMs) {
            return StreamId(id.ms, topSeq + 1);
        }
        return StreamId(id.ms, 0);
    }
    var seq = id.seq;
    if (seq == nil) {
        seq = 0;
    }
    if (id.ms == 0 and seq == 0) {
        return ID_ZERO;
    }
    if (id.ms < topMs or (id.ms == topMs and seq <= topSeq)) {
        return ID_NOT_ABOVE_TOP;
    }
    return StreamId(id.ms, seq);
}

fun cmdXadd(ctx, argv) {
    if (len(argv) < 5 or len(argv) % 2 == 0) {
        return wrongArgs("xadd");
    }
    var key = argv[1];
    var stream = streamEntry(key);
    if (stream == false) {
        return WRONGTYPE;
    }
    var topMs = 0;
    var topSeq = 0;
    if (stream != nil) {
        topMs = stream.topMs();
        topSeq = stream.topSeq();
    }
    var id = nextStreamId(argv[2], topMs, topSeq);
    if (type(id) == "String") {
        return id;
    }
    if (stream == nil) {
        stream = Stream();
        store[key] = Entry("stream", stream, nil);
    }
    stream.add(id.ms, id.seq, argv[3:len(argv)]);
    wakeReaders(key, stream);
    return bulk(idText(id.ms, id.seq));
}

// The bounds of an XRANGE argument: "-" is the least ID and "+" the
// greatest. A missing sequence part is 0 at the start and the greatest at
// the end, so "5" covers every entry of millisecond 5.
fun rangeBound(text, missingSeq) {
    if (text == "-") {
        return StreamId(0, 0);
    }
    if (text == "+") {
        return StreamId(MAX_ID_PART, MAX_ID_PART);
    }
    var id = parseStreamId(text, false);
    if (id == nil) {
        return nil;
    }
    if (id.seq == nil) {
        id.seq = missingSeq;
    }
    return id;
}

// The arguments of one XRANGE, parsed.
class XrangeArgs {
    init(start, end, count) {
        this.start = start;
        this.end = end;
        this.count = count;
    }
}

// Parses the arguments of XRANGE. Returns an XrangeArgs, or an error reply.
// It reads no key, so the session runs it before the command and may yield
// (mayYield) every ELEMENTS_PER_YIELD options.
fun parseXrange(argv, mayYield) {
    if (len(argv) < 4) {
        return wrongArgs("xrange");
    }
    var count = nil;
    var i = 4;
    while (i < len(argv)) {
        if (upper(argv[i]) != "COUNT" or i + 1 >= len(argv)) {
            return SYNTAX_ERROR;
        }
        count = parseInteger(argv[i + 1]);
        if (count == nil) {
            return NOT_INTEGER;
        }
        i = i + 2;
        if (mayYield and i % (2 * ELEMENTS_PER_YIELD) == 0) {
            yield nil;
        }
    }
    var start = rangeBound(argv[2], 0);
    var end = rangeBound(argv[3], MAX_ID_PART);
    if (start == nil or end == nil) {
        return INVALID_ID;
    }
    return XrangeArgs(start, end, count);
}

// ctx is the XrangeArgs that the session parsed before the command, or nil.
fun cmdXrange(ctx, argv) {
    var args = ctx;
    if (args == nil) {
        args = parseXrange(argv, false);
    }
    if (type(args) == "String") {
        return args;
    }
    var stream = streamEntry(argv[1]);
    if (stream == false) {
        return WRONGTYPE;
    }
    if (stream == nil) {
        return "*0\r\n";
    }
    if (args.count != nil and args.count <= 0) {
        return NULL_ARRAY;
    }
    var from = stream.find(args.start.ms, args.start.seq, true);
    var to = stream.find(args.end.ms, args.end.seq, false);
    if (to <= from) {
        return "*0\r\n";
    }
    if (args.count != nil and to - from > args.count) {
        to = from + args.count;
    }
    var reply = Segments("");
    reply.add(nil, stream, from, to);
    return reply;
}

// What one XREAD BLOCK waits for: for each key (for a key named twice, the
// last one), the ID after which it reads, or for "$" the Stream that the key
// held, and the most entries for each stream (0 for no limit).
class StreamRead {
    init(count) {
        this.after = {};
        this.count = count;
    }
}

// Adds to reply the entries of stream above id, at most count of them when
// count is above 0. Returns true when there are some. An ID at or above the
// top costs one comparison, with no search.
fun addEntriesAfter(reply, count, key, stream, id) {
    if (!stream.hasAbove(id.ms, id.seq)) {
        return false;
    }
    var from = stream.find(id.ms, id.seq, false);
    var to = stream.size();
    if (count > 0 and to - from > count) {
        to = from + count;
    }
    reply.add(key, stream, from, to);
    return true;
}

// The arguments of one XREAD, parsed: ids[j] is a StreamId, or "$".
class XreadArgs {
    init(count, block, keys, ids) {
        this.count = count;
        this.block = block;
        this.keys = keys;
        this.ids = ids;
    }
}

// Parses the arguments of XREAD. Returns an XreadArgs, or an error reply.
// It reads no key, so the session runs it before the command and may yield
// (mayYield) every ELEMENTS_PER_YIELD IDs: an XREAD can name up to 524287
// streams.
fun parseXread(argv, mayYield) {
    if (len(argv) < 4) {
        return wrongArgs("xread");
    }
    var count = 0;
    var block = nil;
    var i = 1;
    while (i < len(argv) and upper(argv[i]) != "STREAMS") {
        var word = upper(argv[i]);
        if (i + 1 >= len(argv)) {
            return SYNTAX_ERROR;
        }
        if (word == "COUNT") {
            count = parseInteger(argv[i + 1]);
            if (count == nil) {
                return NOT_INTEGER;
            }
        } else if (word == "BLOCK") {
            block = parseInteger(argv[i + 1]);
            if (block == nil) {
                return errorReply("ERR timeout is not an integer or out of range");
            }
            if (block < 0) {
                return errorReply("ERR timeout is negative");
            }
        } else {
            return SYNTAX_ERROR;
        }
        i = i + 2;
        if (mayYield and i % (2 * ELEMENTS_PER_YIELD) == 1) {
            yield nil;
        }
    }
    if (i >= len(argv)) {
        return SYNTAX_ERROR;
    }
    var rest = len(argv) - i - 1;
    if (rest == 0 or rest % 2 == 1) {
        return errorReply("ERR Unbalanced XREAD list of streams: for each stream key an ID or '$' must be specified.");
    }
    var n = rest / 2;
    var ids = [];
    var j = 0;
    for (var text in argv[i + 1 + n:len(argv)]) {
        var id = "$";
        if (text != "$") {
            id = parseStreamId(text, false);
            if (id == nil) {
                return INVALID_ID;
            }
            if (id.seq == nil) {
                id.seq = 0;
            }
        }
        ids.append(id);
        j = j + 1;
        if (mayYield and j % ELEMENTS_PER_YIELD == 0) {
            yield nil;
        }
    }
    return XreadArgs(count, block, argv[i + 1:i + 1 + n], ids);
}

// ctx is the XreadArgs that the session parsed before the command, or nil.
// The rest has no suspend point: it reads the streams and joins the queues
// in one step.
fun cmdXread(ctx, argv) {
    var args = ctx;
    if (args == nil) {
        args = parseXread(argv, false);
    }
    if (type(args) == "String") {
        return args;
    }
    var blocking = args.block != nil;
    var read = StreamRead(args.count);
    var reply = Segments("");
    var j = 0;
    // This loop can run over 524287 keys in one step, so it reads each key
    // with one Map access and no call where it can.
    for (var key in args.keys) {
        var entry = store[key];
        if (entry != nil and entry.expiresAt != nil) {
            entry = lookup(key);
        }
        var stream = nil;
        if (entry != nil) {
            if (entry.kind != "stream") {
                return WRONGTYPE;
            }
            stream = entry.value;
        }
        var id = args.ids[j];
        if (id == "$") {
            // No entry is above the top, so only a wait needs it. A wait
            // stores the Stream itself, with no new object; see
            // wakeReaders.
            if (blocking) {
                if (stream == nil) {
                    read.after[key] = ZERO_ID;
                } else {
                    read.after[key] = stream;
                }
            }
        } else {
            if (blocking) {
                read.after[key] = id;
            }
            if (stream != nil) {
                addEntriesAfter(reply, args.count, key, stream, id);
            }
        }
        j = j + 1;
    }
    if (len(reply.keys) > 0) {
        reply.head = "*" + str(len(reply.keys)) + "\r\n";
        return reply;
    }
    if (args.block == nil) {
        return NULL_ARRAY;
    }
    return Block(readers, args.keys, args.block / 1000, read);
}

// Hands each session that waits in XREAD BLOCK on key, and has entries to
// read in stream now, its reply: the entries of this one stream, as Redis
// replies. A waiter whose ID is still above the top waits on. It runs at the
// end of XADD, so the reply holds the entries up to this one.
fun wakeReaders(key, stream) {
    var later = [];
    while (true) {
        var w = takeWaiter(readers, key);
        if (w == nil) {
            break;
        }
        var reply = Segments("*1\r\n");
        var after = w.read.after[key];
        var has = true;
        if (after == stream) {
            // "$" on this same Stream: each XADD on it wakes the reader at
            // once, so the entries above the top that "$" named are the one
            // entry of this XADD.
            var n = stream.size();
            reply.add(key, stream, n - 1, n);
        } else {
            if (hasField(after, "fields")) {
                // "$" on a Stream that the key no longer holds: nothing
                // appends to it now, so its top is the top at the wait.
                after = StreamId(after.topMs(), after.topSeq());
            }
            has = addEntriesAfter(reply, w.read.count, key, stream, after);
        }
        if (!has) {
            later.append(w);
        } else {
            w.active = false;
            w.servedBy = key;
            w.ready = reply;
            try {
                task.send(w.handle, Msg.Ready());
            } catch (ignored) {
                // The waiter's task has ended. XREAD takes nothing, so
                // nothing goes back.
            }
        }
    }
    for (var w in later) {
        joinQueues(readers, w, [key]);
    }
}

// ===========================================================================
// Transactions
// ===========================================================================

// The largest value that INCR gives: a value has at most 15 digits, so that
// it is exact in a Number. Redis allows the full 64-bit range.
var INCR_MAX = 999999999999999;

fun cmdIncr(ctx, argv) {
    if (len(argv) != 2) {
        return wrongArgs("incr");
    }
    var entry = lookup(argv[1]);
    if (entry == nil) {
        store[argv[1]] = Entry("string", "1", nil);
        return integerReply(1);
    }
    if (entry.kind != "string") {
        return WRONGTYPE;
    }
    var n = parseInteger(entry.value);
    if (n == nil) {
        return NOT_INTEGER;
    }
    if (n >= INCR_MAX) {
        return errorReply("ERR increment or decrement would overflow");
    }
    n = n + 1;
    // The key keeps its expiry, as in Redis.
    entry.value = str(n);
    return integerReply(n);
}

// The commands that a client queued after MULTI. dirty is true when one of
// them was rejected, so that EXEC runs none of them. args counts the
// arguments of the queued commands, for the bound of README rule 4.
// ctxs[i] is the parse of queued[i] (PARSERS), or nil.
class Transaction {
    init() {
        this.queued = [];
        this.ctxs = [];
        this.dirty = false;
        this.args = 0;
    }
}

// The bounds of one transaction: at most TX_COMMANDS commands and TX_ARGS
// arguments in all. EXEC runs the whole queue in one step, so these bound
// that step (README rules 4 and 6). Redis has no such bound.
var TX_COMMANDS = 65536;
var TX_ARGS = 1048576;

// The number of arguments of each command, as Redis 7.0 checks it before it
// runs or queues the command: n for exactly n, -n for at least n.
var ARITY = {
    "PING": -1, "ECHO": 2, "SET": -3, "GET": 2, "INFO": -1,
    "RPUSH": -3, "LPUSH": -3, "LLEN": 2, "LRANGE": 4, "LPOP": -2,
    "BLPOP": -3, "TYPE": 2, "XADD": -5, "XRANGE": -4, "XREAD": -4,
    "INCR": 2, "MULTI": 1, "EXEC": 1, "DISCARD": 1
};

fun arityOk(name, count) {
    var a = ARITY[name];
    if (a < 0) {
        return count >= -a;
    }
    return count == a;
}

// Redis 7.0 gives this text for EXEC with arguments, also with no MULTI.
var EXEC_ARITY = "-EXECABORT Transaction discarded because of: wrong number of arguments for 'exec' command\r\n";

// MULTI, EXEC and DISCARD outside a transaction. Returns the reply.
fun beginOrRefuse(conn, name, argv) {
    if (!arityOk(name, len(argv))) {
        if (name == "EXEC") {
            return EXEC_ARITY;
        }
        return wrongArgs(lower(name));
    }
    if (name == "MULTI") {
        conn.tx = Transaction();
        return simple("OK");
    }
    return errorReply("ERR " + name + " without MULTI");
}

// A command of a client in a transaction: queue it, or end the
// transaction. Returns the reply: a String, or the List of the replies of
// EXEC.
fun inTransaction(conn, name, argv) {
    var tx = conn.tx;
    if (COMMANDS[name] == nil and ARITY[name] == nil) {
        tx.dirty = true;
        return unknownCommand(argv);
    }
    if (!arityOk(name, len(argv))) {
        if (name == "EXEC") {
            conn.tx = nil;
            return EXEC_ARITY;
        }
        tx.dirty = true;
        return wrongArgs(lower(name));
    }
    if (name == "MULTI") {
        return errorReply("ERR MULTI calls can not be nested");
    }
    if (name == "DISCARD") {
        conn.tx = nil;
        return simple("OK");
    }
    if (name == "EXEC") {
        conn.tx = nil;
        if (tx.dirty) {
            return errorReply("EXECABORT Transaction discarded because of previous errors.");
        }
        return execQueued(tx);
    }
    if (len(tx.queued) >= TX_COMMANDS or tx.args + len(argv) > TX_ARGS) {
        tx.dirty = true;
        return errorReply("ERR the transaction holds too many commands or arguments");
    }
    // The parse reads no key, so it runs now, with yields, and EXEC passes
    // it to the command. A parse error is a reply of EXEC, as in Redis.
    var ctx = nil;
    var parse = PARSERS[name];
    if (parse != nil) {
        ctx = parse(argv, true);
    }
    tx.queued.append(argv);
    tx.ctxs.append(ctx);
    tx.args = tx.args + len(argv);
    return simple("QUEUED");
}

// Runs the queued commands in one step, with no suspend point: each command
// gets the parse that was made when it was queued. A command that would
// wait (BLPOP, XREAD BLOCK) gives a null array at once, as in Redis.
// Returns the List of the replies; the session writes them after the step.
fun execQueued(tx) {
    var replies = [];
    var i = 0;
    for (var argv in tx.queued) {
        var reply = execute(tx.ctxs[i], argv);
        i = i + 1;
        if (type(reply) == "Instance" and hasField(reply, "timeout")) {
            reply = NULL_ARRAY;
        }
        replies.append(reply);
    }
    return replies;
}

// Writes the replies of EXEC as one array, in steps.
fun writeReplies(conn, replies) {
    var out = Output(conn);
    out.add("*" + str(len(replies)) + "\r\n");
    for (var reply in replies) {
        if (type(reply) == "String") {
            out.add(reply);
        } else {
            out.flush();
            writeReply(conn, reply);
        }
    }
    out.flush();
}

// Writes one reply of a command: a String, Bulks or Segments.
fun writeReply(conn, reply) {
    if (type(reply) == "Instance" and hasField(reply, "fwd")) {
        writeBulks(conn, reply);
    } else if (type(reply) == "Instance") {
        writeSegments(conn, reply);
    } else if (reply != "") {
        conn.sock.write(reply);
    }
}

// ===========================================================================
// Command table
// ===========================================================================

fun cmdPing(ctx, argv) {
    if (len(argv) == 1) {
        return simple("PONG");
    }
    if (len(argv) == 2) {
        return bulk(argv[1]);
    }
    return wrongArgs("ping");
}

fun cmdEcho(ctx, argv) {
    if (len(argv) != 2) {
        return wrongArgs("echo");
    }
    return bulk(argv[1]);
}

fun cmdSetEntry(ctx, argv) {
    return cmdSet(argv);
}

fun cmdGetEntry(ctx, argv) {
    return cmdGet(argv);
}

fun cmdInfoEntry(ctx, argv) {
    return cmdInfo(argv);
}

var COMMANDS = {
    "PING": cmdPing,
    "ECHO": cmdEcho,
    "SET": cmdSetEntry,
    "GET": cmdGetEntry,
    "INFO": cmdInfoEntry,
    "RPUSH": cmdRpush,
    "LPUSH": cmdLpush,
    "LLEN": cmdLlen,
    "LRANGE": cmdLrange,
    "LPOP": cmdLpop,
    "BLPOP": cmdBlpop,
    "TYPE": cmdType,
    "XADD": cmdXadd,
    "XRANGE": cmdXrange,
    "XREAD": cmdXread,
    "INCR": cmdIncr
};

// Commands whose arguments the session parses before the command runs
// (rule 5 of the README): the parse reads no key and may yield.
var PARSERS = {
    "XRANGE": parseXrange,
    "XREAD": parseXread
};

// Returns an encoded reply, "" for no reply, or a Block.
fun execute(ctx, argv) {
    if (len(argv) == 0) {
        return "";
    }
    var run = COMMANDS[upper(argv[0])];
    if (run == nil) {
        return unknownCommand(argv);
    }
    return run(ctx, argv);
}

// ===========================================================================
// Connection: reader task and session task
// ===========================================================================

// Limits on what one client can make the server read and hold, as in Redis
// 7.0. Work for each byte in Lox++ is allowed only under INLINE_MAX.
var INLINE_MAX = 65536;
var ARRAY_MAX = 1048576;
var BULK_MAX = 536870912;

// The most bytes of one command, as Redis's client-query-buffer-limit
// (1 GB by default; the flag --client-query-buffer-limit sets it). Redis
// closes a client that passes it, with no reply, and so does this server.
var QUERY_MAX = 1073741824;

class QueryLimit {
    init() {
        this.kind = "QueryLimit";
        this.message = "closing a client that reached the query buffer limit";
    }
}

// A reader yields after this many array elements, so that one long array
// does not keep the other tasks of the worker from running.
var ELEMENTS_PER_YIELD = 1024;

// Reads one command. Returns [args, nbytes], or nil at end of stream.
// nbytes counts every byte of the command on the wire: readline() drops the
// '\n', so each line adds one.
fun readCommand(sock) {
    var blankLines = 0;
    while (true) {
        var raw = sock.readline();
        if (raw == nil) {
            return nil;
        }
        var nbytes = len(raw) + 1;
        var line = trimCR(raw);
        if (line == "") {
            // An empty line is not a command, but a client can send only
            // these, so they count for the yield as commands do.
            blankLines = blankLines + 1;
            if (blankLines % WINDOW == 0) {
                yield nil;
            }
            continue;
        }
        if (line[0] != "*") {
            if (len(raw) > INLINE_MAX) {
                throw ProtocolError("Protocol error: too big inline request");
            }
            if (nbytes > QUERY_MAX) {
                throw QueryLimit();
            }
            return [splitWords(line), nbytes];
        }
        var count = parseInteger(line[1:len(line)]);
        if (count == nil or count > ARRAY_MAX) {
            throw ProtocolError("Protocol error: invalid multibulk length");
        }
        var argv = [];
        var i = 0;
        while (i < count) {
            if (i > 0 and i % ELEMENTS_PER_YIELD == 0) {
                yield nil;
            }
            var hraw = sock.readline();
            if (hraw == nil) {
                return nil;
            }
            nbytes = nbytes + len(hraw) + 1;
            var header = trimCR(hraw);
            if (len(header) == 0 or header[0] != "$") {
                var got = "end of line";
                if (len(header) > 0) {
                    got = "'" + header[0] + "'";
                }
                throw ProtocolError("Protocol error: expected '$', got " + got);
            }
            var size = parseInteger(header[1:len(header)]);
            if (size == nil or size < 0 or size > BULK_MAX) {
                throw ProtocolError("Protocol error: invalid bulk length");
            }
            if (nbytes + size + 2 > QUERY_MAX) {
                throw QueryLimit();
            }
            // Two reads, so that a large bulk is not copied by a slice.
            var data = sock.read_bytes(size);
            if (len(data) < size) {
                return nil;
            }
            var end = sock.read_bytes(2);
            if (len(end) < 2) {
                return nil;
            }
            if (end != "\r\n") {
                throw ProtocolError("Protocol error: bulk string not followed by CRLF");
            }
            nbytes = nbytes + size + 2;
            argv.append(data);
            i = i + 1;
        }
        return [argv, nbytes];
    }
}

fun printFault(prefix, e) {
    try {
        print prefix + faultText(e);
    } catch (ignored) {
    }
}

// The two tasks of one connection, and its socket. Both tasks run on the
// one worker, so they share this object.
class Conn {
    init(sock) {
        this.sock = sock;
        this.session = nil;
        this.reader = nil;
        // The tasks of this connection that have not ended.
        this.liveTasks = 2;
        // True while the session waits in BLPOP. The reader reads on then,
        // past its credit, so that it sees the end of the stream.
        this.blocked = false;
        // The Transaction after MULTI, or nil.
        this.tx = nil;
    }
}

// The connections with a task that has not ended. INFO reports it as
// connected_clients, so a task that outlives its connection shows there.
var connectedClients = 0;

fun taskEnded(conn) {
    conn.liveTasks = conn.liveTasks - 1;
    if (conn.liveTasks == 0) {
        connectedClients = connectedClients - 1;
    }
}

// The reader sends at most WINDOW commands that the session has not done.
// So a client that sends without reading its replies fills at most WINDOW
// messages of the session mailbox; after that the reader stops reading, and
// TCP makes the client wait. The reader also yields every WINDOW commands,
// so a client that sends a long pipeline does not keep the other tasks of
// the worker from running.
var WINDOW = 64;

// While the session waits in BLPOP it gives no credit, but the reader must
// read on: the end of the stream comes after the bytes before it, and
// without it a wait with no time limit outlives a client that has gone. So
// during a wait the reader may send HOLD commands past its credit, which
// keeps the session mailbox at most WINDOW + HOLD = 1024 messages. A client
// that sends more during one wait is closed. Redis keeps such commands in
// the query buffer of the client up to client-query-buffer-limit.
var HOLD = 1024 - WINDOW;

// Waits until the session gives back at least one credit or starts a wait
// in BLPOP. Returns the credits that it got (0 for Blocked alone), or nil
// when the session has ended.
fun awaitCredit() {
    var credits = 0;
    var msg = task.receive();
    while (true) {
        var got = match msg {
            case Msg.Credit => 1
            case Msg.Blocked => 0
            case Msg.Stop => -1
            // Only the session sends to the reader, and it sends only these
            // three.
            case Msg.Cmd(_, _) or Msg.Fail(_) or Msg.Closed or Msg.Served(_, _) or Msg.Ready => -1
        };
        if (got < 0) {
            return nil;
        }
        credits = credits + got;
        if (task.pending() == 0) {
            return credits;
        }
        msg = task.receive();
    }
}

// Returns the credits with which the reader reads the next command, nil
// when the session has ended, or false when the client sent more than HOLD
// commands during one wait in BLPOP.
fun creditGate(conn, credits) {
    while (credits <= 0) {
        if (conn.blocked) {
            if (credits <= -HOLD) {
                return false;
            }
            return credits;
        }
        var more = awaitCredit();
        if (more == nil) {
            return nil;
        }
        credits = credits + more;
    }
    return credits;
}

fun readLoop(conn) {
    defer taskEnded(conn);
    var credits = WINDOW;
    var sinceYield = 0;
    try {
        while (true) {
            var cmd = readCommand(conn.sock);
            if (cmd == nil) {
                break;
            }
            task.send(conn.session, Msg.Cmd(toArgs(cmd[0]), cmd[1]));
            credits = credits - 1;
            sinceYield = sinceYield + 1;
            if (sinceYield == WINDOW) {
                sinceYield = 0;
                yield nil;
            }
            var next = creditGate(conn, credits);
            if (next == nil) {
                return;
            }
            if (next == false) {
                break;
            }
            credits = next;
        }
    } catch (e) {
        var kind = faultKind(e);
        if (kind == "ProtocolError") {
            try {
                task.send(conn.session, Msg.Fail(faultText(e)));
            } catch (ignored) {
            }
        } else if (kind != "DeadTaskError" and kind != "SocketClosedError"
                   and kind != "NetworkError" and kind != "QueryLimit") {
            // A reset by the client is a NetworkError: it is normal, so it
            // is not printed.
            printFault("read fault: ", e);
        }
    }
    try {
        task.send(conn.session, Msg.Closed());
    } catch (ignored) {
    }
}

// Returns true while the session goes on. A Block reply waits in the
// session; the client's next commands stay in the mailbox until it ends.
fun runCommand(conn, argv) {
    var ctx = nil;
    if (len(argv) > 0) {
        var name = upper(argv[0]);
        if (conn.tx != nil or name == "MULTI" or name == "EXEC" or name == "DISCARD") {
            var reply = nil;
            if (conn.tx != nil) {
                reply = inTransaction(conn, name, argv);
            } else {
                reply = beginOrRefuse(conn, name, argv);
            }
            if (type(reply) == "List") {
                writeReplies(conn, reply);
            } else {
                conn.sock.write(reply);
            }
            giveCredit(conn);
            return true;
        }
        var parse = PARSERS[name];
        if (parse != nil) {
            ctx = parse(argv, true);
        }
    }
    var reply = execute(ctx, argv);
    if (type(reply) == "Instance" and hasField(reply, "timeout")) {
        reply = waitForElement(conn, reply);
        if (reply == nil) {
            return false;
        }
    }
    writeReply(conn, reply);
    giveCredit(conn);
    return true;
}

fun writeBulks(conn, reply) {
    var r = len(reply.rev);
    var n = r + len(reply.fwd);
    conn.sock.write("*" + str(n) + "\r\n");
    var i = 0;
    while (i < n) {
        var stop = i + ELEMENTS_PER_YIELD;
        if (stop > n) {
            stop = n;
        }
        var parts = [];
        while (i < stop) {
            if (i < r) {
                parts.append(bulk(reply.rev[r - 1 - i]));
            } else {
                parts.append(bulk(reply.fwd[i - r]));
            }
            i = i + 1;
        }
        conn.sock.write(joinRange(parts, 0, len(parts)));
        if (i < n) {
            yield nil;
        }
    }
}

// Collects reply parts and writes them in steps of at most
// ELEMENTS_PER_YIELD parts and about STEP_BYTES bytes, and yields after each
// step. A part of STEP_BYTES or more goes to the socket alone, so no step
// copies a long part.
var STEP_BYTES = 1048576;

class Output {
    init(conn) {
        this.conn = conn;
        this.parts = [];
        this.bytes = 0;
    }

    add(part) {
        if (len(part) >= STEP_BYTES) {
            this.flush();
            this.conn.sock.write(part);
            yield nil;
            return;
        }
        this.parts.append(part);
        this.bytes = this.bytes + len(part);
        if (len(this.parts) >= ELEMENTS_PER_YIELD or this.bytes >= STEP_BYTES) {
            this.flush();
            yield nil;
        }
    }

    // A bulk string, with no copy of a long value.
    addBulk(s) {
        if (len(s) >= STEP_BYTES) {
            this.add("$" + str(len(s)) + "\r\n");
            this.add(s);
            this.add("\r\n");
        } else {
            this.add(bulk(s));
        }
    }

    flush() {
        if (len(this.parts) > 0) {
            this.conn.sock.write(joinRange(this.parts, 0, len(this.parts)));
        }
        this.parts = [];
        this.bytes = 0;
    }
}

fun writeSegments(conn, reply) {
    var out = Output(conn);
    if (reply.head != "") {
        out.add(reply.head);
    }
    var i = 0;
    while (i < len(reply.keys)) {
        var stream = reply.streams[i];
        var j = reply.froms[i];
        var to = reply.tos[i];
        if (reply.keys[i] != nil) {
            out.add("*2\r\n");
            out.addBulk(reply.keys[i]);
        }
        out.add("*" + str(to - j) + "\r\n");
        while (j < to) {
            var fields = stream.fields[j];
            out.add("*2\r\n" + bulk(idText(stream.ms[j], stream.seq[j])) + "*" + str(len(fields)) + "\r\n");
            for (var f in fields) {
                out.addBulk(f);
            }
            j = j + 1;
        }
        i = i + 1;
    }
    out.flush();
}

fun giveCredit(conn) {
    try {
        task.send(conn.reader, Msg.Credit());
    } catch (ignored) {
        // The reader has ended; the session ends at its Closed message.
    }
}

// Returns false: a protocol error ends the connection.
fun failConnection(conn, text) {
    conn.sock.write(errorReply("ERR " + text));
    return false;
}

// When the session ends, it closes the socket and stops the reader. The
// close wakes a reader that waits in a read, and Stop wakes a reader that
// waits for credit, so no task of the connection outlives it.
fun endSession(conn) {
    conn.sock.close();
    try {
        task.send(conn.reader, Msg.Stop());
    } catch (ignored) {
    }
}

fun sessionLoop(conn) {
    defer taskEnded(conn);
    defer endSession(conn);
    try {
        var running = true;
        while (running) {
            var msg = task.receive();
            running = match msg {
                case Msg.Cmd(args, nbytes) => runCommand(conn, fromArgs(args))
                case Msg.Fail(text) => failConnection(conn, text)
                case Msg.Closed => false
                // Only the reader sends to the session, and it never sends
                // these.
                case Msg.Credit or Msg.Blocked or Msg.Stop => true
                // A pusher sends Served, and XADD sends Ready, only to a
                // session that waits in waitForElement, which takes it there.
                case Msg.Served(_, _) or Msg.Ready => true
            };
        }
    } catch (e) {
        var kind = faultKind(e);
        if (kind != "NetworkError" and kind != "SocketClosedError") {
            printFault("connection fault: ", e);
        }
    }
}

// task.spawn passes no arguments, so closures hold the connection. Both
// handles are set before either task first runs: the accept loop does not
// suspend between the two spawns.
fun startConnection(sock) {
    var conn = Conn(sock);
    connectedClients = connectedClients + 1;
    fun runSession() {
        sessionLoop(conn);
    }
    fun runReader() {
        readLoop(conn);
    }
    conn.session = task.spawn(runSession);
    conn.reader = task.spawn(runReader);
}

// ===========================================================================
// Start
// ===========================================================================

fun flagValue(name, fallback) {
    var a = args();
    var i = 0;
    while (i + 1 < len(a)) {
        if (a[i] == name) {
            return a[i + 1];
        }
        i = i + 1;
    }
    return fallback;
}

fun main() {
    var port = parseInteger(flagValue("--port", "6379"));
    var queryMax = parseInteger(flagValue("--client-query-buffer-limit", str(QUERY_MAX)));
    if (queryMax == nil or queryMax < 1) {
        print "redis.lox: --client-query-buffer-limit needs a positive integer";
        exit(64);
    }
    QUERY_MAX = queryMax;
    if (port == nil) {
        print "redis.lox: --port needs an integer";
        exit(64);
    }
    var server = listen("0.0.0.0", port);
    // A fault of accept() that does not go away would print every 20 ms, so
    // the first one is the only one printed.
    var acceptFaultPrinted = false;
    while (true) {
        try {
            var sock = server.accept();
            startConnection(sock);
        } catch (e) {
            if (!acceptFaultPrinted) {
                acceptFaultPrinted = true;
                printFault("accept fault: ", e);
            }
            sleep(0.02);
        }
    }
}

main();
