// Regression test: an if/else inside a catch body places its own
// skip-target CFG label mid-handler. A pass that
// took the first such label as the end of the catch region would truncate
// the handler there and splice the rest of the catch body (plus the
// if/else's own conditional branch) outside the `catch` block it was still
// lexically inside.
//
// Fixed by deriving the region's end from the compiler's own declared
// PUSH_HANDLER/POP_HANDLER boundary instead of scanning for a label.

fun f(x) {
    try {
        throw "boom";
    } catch (e) {
        if (x) {
            print "yes";
        } else {
            print "no";
        }
        print "after-if-in-catch";
    }
    print "after-try";
}
f(true);
f(false);

// CHECK: yes
// CHECK: after-if-in-catch
// CHECK: after-try
// CHECK: no
// CHECK: after-if-in-catch
// CHECK: after-try
