// A match-in-catch, then an ordinary `var` declared between two sibling
// try/catch blocks, read only after both have run. Shows an ordinary local
// keeps the slot the compiler gave it — the match-in-catch miscount must
// not displace a local that has nothing to do with `match` or `catch`.
//
// The try body throws through an if/else rather than a bare `throw`: an
// if/else re-anchors the compiler's own operand-height counter on exit, so
// this shape does not rely on an unrelated, unbalanced counter elsewhere
// happening to cancel out the defect under test.

enum Shape { Circle(r) Square(side) }
fun f() {
    try {
        if (true) { throw Circle(3); } else { throw Square(4); }
    } catch (e) {
        var described = match e {
            case Circle(r)    => "caught a circle r=" + str(r)
            case Square(side) => "caught a square side=" + str(side)
            case _            => "caught something else"
        };
        print described;
    }
    try { throw "first-fault"; }
    catch (e1) { print "first caught: " + e1; }

    var marker = "still here";

    try { throw "second-fault"; }
    catch (e2) { print "second caught: " + e2; }

    print marker;
}
f();

// CHECK: caught a circle r=3
// CHECK: first caught: first-fault
// CHECK: second caught: second-fault
// CHECK: still here
