// Test: Error .kind and .message fields on internally-raised faults.
// The text of .message is implementation-defined, so only its type is printed.
try {
    var list = [];
    print list[10];
} catch (e) {
    print "kind: " + e.kind;
    print "message: " + type(e.message);
}

// Test multiple error kinds
try {
    42();
} catch (e) {
    print "kind: " + e.kind;
}

try {
    var x = undefined_var;
} catch (e) {
    print "kind: " + e.kind;
}

print "done";
// CHECK: kind: IndexOutOfBoundsError
// CHECK: message: String
// CHECK: kind: NotCallableError
// CHECK: kind: UndefinedVariableError
// CHECK: done
