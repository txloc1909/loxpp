enum Shape { Circle(r) Square(side) }
fun f(v) {
    try {
        throw v;
    } catch (e) {
        return match e {
            case Shape.Circle(r)    => "circle r=" + str(r)
            case Shape.Square(side) => "square side=" + str(side)
            case _            => "other"
        };
    }
}
print f(Shape.Circle(3));
print f(Shape.Square(4));
