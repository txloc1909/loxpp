// `var x = yield e;`: the yield expression's operand is delivered to the
// resumer, and the value the next resume sends becomes the yield expression's
// value. Omitting the operand yields nil; a later resume's single argument (or
// nil) fills it.
// Mission #523 node #525; goes green with the native coroutine primitive
// (#526).
fun gen() {
    var a = yield 1;
    print "a=" + str(a);
    var b = yield 2;
    print "b=" + str(b);
    return a + b;
}

var co = coroutine.create(gen);

print co.resume();
print co.resume(10);
print co.resume(32);
print co.status();

// CHECK: 1
// CHECK: a=10
// CHECK: 2
// CHECK: b=32
// CHECK: 42
// CHECK: dead
