// CHECK: Int
// CHECK: 5
// CHECK: 0
// CHECK: 0
// CHECK: -7
// CHECK: 1234567
// CHECK: 4503599627370496
// CHECK: 9223372036854774784
// CHECK: -9223372036854775808
// CHECK: 18014398509481984
// CHECK: 42
// CHECK: -42
// CHECK: 7
// CHECK: 7
// CHECK: 0
// CHECK: 0
// CHECK: 9223372036854775807
// CHECK: -9223372036854775808
// CHECK: -9223372036854775808
// CHECK: 123
// CHECK: 9223372036854775807
// CHECK: Int
// CHECK: 2
// CHECK: 3
// CHECK: -3
// CHECK: true
// CHECK: Number
// CHECK: true
// CHECK: true
// CHECK: true
// CHECK: true
// CHECK: true
// CHECK: true
// CHECK: false
// CHECK: 2.5
// CHECK: -0.25
// CHECK: 3
// CHECK: 7.5
// CHECK: 0
// CHECK: 12
