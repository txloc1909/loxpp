// Issue #238 / #267: unbounded recursion overflows the call stack, and
// spec/04-semantics.md marks StackOverflowError catchable, matching every
// other runtime fault. A live handler must catch a real Error value (not
// nil) with kind "StackOverflowError", the same as native.
//
// This file lives outside the parent translation-probes directory, and
// outside examples/, on purpose, matching 31_deep_recursion.lox's own
// note: the JVM backend has no call-frame ceiling of its own yet (#268,
// open), so it currently dies with a raw, uncaught java.lang.
// StackOverflowError instead of reaching the try/catch below at all —
// this file would otherwise make every JVM corpus/probe sweep report a
// new divergence. check_clr_probes.sh names this file directly.
fun f(n) { return f(n + 1); }
try {
    f(0);
    print "no error";
} catch (e) {
    print "caught";
    print e == nil;
    print e.kind;
}
print "after";
