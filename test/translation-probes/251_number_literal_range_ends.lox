// STATUS: ok
// Each line is one boundary of the rounding rule: the decimal goes to the
// nearest double over the whole range of the format, so a decimal that is
// just outside the range comes back to the end of the range
// (spec/01-lexical.md, the range of a Number literal).

// COVERS: number-literal-range largest-finite
print ;
// CHECK: 1.7976931348623157e+308

// COVERS: number-literal-range above-largest-finite
print ;
// CHECK: 1.7976931348623157e+308

// COVERS: number-literal-range overflow
print ;
// CHECK: inf

// COVERS: number-literal-range smallest-subnormal
print 0.;
// CHECK: 5e-324

// COVERS: number-literal-range below-smallest-subnormal
print 0.;
// CHECK: 5e-324
