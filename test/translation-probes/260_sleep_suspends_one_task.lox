// A call that waits for the network or for time suspends only its task, so
// the other tasks of its worker run during the wait (spec/04-semantics.md,
// Suspend Points). Here the task
// `sleeper` waits in sleep(), and the task `ticker` of the same worker runs
// before the sleep ends.
// STATUS: ok
// TIMEOUT: 10
// COVERS: suspend-call sleep in sleeper
// CHECK: ticker ran
// CHECK: sleeper woke
var me = task.self();
fun sleeper() { sleep(0.3); print "sleeper woke"; task.send(me, "done"); }
fun ticker() { print "ticker ran"; task.send(me, "done"); }
task.spawn(sleeper);
task.spawn(ticker);
task.receive();
task.receive();
