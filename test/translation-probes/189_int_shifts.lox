// `a << n` shifts left and wraps, `a >> n` shifts right and copies the sign
// bit, and `a >>> n` shifts right and fills the left end with zero bits
// (spec/04-semantics.md, Bit Operators). The counts run from 0 to 63, the
// whole valid range, with the values 1, -1, the smallest and the largest Int,
// and bit patterns.

fun shl(a, n) { return a << n; }
fun shr(a, n) { return a >> n; }
fun ushr(a, n) { return a >>> n; }
print shl(1i, 0i);
print shl(1i, 1i);
print shl(1i, 32i);
print shl(1i, 47i);
print shl(1i, 63i);
print shl(-1i, 0i);
print shl(-1i, 1i);
print shl(-1i, 32i);
print shl(-1i, 47i);
print shl(-1i, 63i);
