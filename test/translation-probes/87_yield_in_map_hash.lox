// A yield in __hash__ while a map operation calls it is a yield across a
// native callback (spec/04-semantics.md, yield Expression): it raises the
// catchable YieldAcrossNativeError. This holds in the main task outside
// every coroutine, where a plain yield is a task switch.
class K {
    __hash__() {
        var v = yield 1;
        print "hash got " + str(v);
        return 1;
    }
    __eq__(other) {
        return true;
    }
}

var m = {};
try {
    m[K()] = 1;
    print "set";
} catch (e) {
    print e.kind;
}
print "after";

// STATUS: ok
// CHECK: YieldAcrossNativeError
// CHECK: after
