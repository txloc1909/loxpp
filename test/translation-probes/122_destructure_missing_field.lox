// A destructuring declaration reads each name as a property read, so a name
// that is neither a field nor a method of an instance is a halting fault, not
// a nil binding (spec/04-semantics.md, Destructuring Declaration).
class Box {
    init() { this.value = 7; }
}

var b = Box();
var {value} = b;
print value;

var {bogus} = b;
print "unreachable";

// STATUS: error
// CHECK: 7
