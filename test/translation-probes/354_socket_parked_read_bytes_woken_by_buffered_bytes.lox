// Task B waits in read_bytes(3) on a Socket. Task A runs and calls readline(),
// which reads the whole write of the peer. The three bytes after the first
// line stay in the buffer of the Socket and the descriptor has no new bytes.
// B must get them. The probe checks the pair of results.
// The CHECK line does not bind the bootstrap interpreter. It runs every worker
// on one host thread, so a blocking read of the first task keeps the other
// task from running (spec/README.md, Conformance: scheduling is
// implementation-defined). The probe on the NOT-BINDING line checks the
// bootstrap's own choice in its place.
// STATUS: ok
// TIMEOUT: 20
// NOT-BINDING: bootstrap bootstrap-only/same_worker_blocking_call.lox
// CHECK: results are a and bcd: true
fun peer(main) {
    var srv = listen("127.0.0.1", 0);
    task.send(main, srv.port());
    var c = srv.accept();
    sleep(0.2);
    c.write("a\nbcd");
    task.receive();
}
var me = task.self();
var w = task.spawn_worker(peer, me);
var s = connect("127.0.0.1", task.receive());
fun spin(secs) {
    var end = clock() + secs;
    while (clock() < end) { }
}
fun b() { task.send(me, str(s.read_bytes(3))); }
fun a() { spin(0.5); task.send(me, str(s.readline())); }
task.spawn(b);
task.spawn(a);
var r0 = "timeout";
try { r0 = task.receive_within(3); } catch (e) { }
var r1 = "timeout";
try { r1 = task.receive_within(3); } catch (e) { }
task.send(w, "done");
print "results are a and bcd: " + str((r0 == "a" and r1 == "bcd") or (r0 == "bcd" and r1 == "a"));
