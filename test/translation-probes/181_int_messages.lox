// An Int is always a message (spec/03-types.md, Messages), and an Enum whose
// fields are Ints is a message. A send copies nothing: the value that a task
// receives is == to the value that was sent, a heap-held Int included. No send
// of an Int raises SendError.

enum Msg { Ask(from, payload) }
var main = task.self();
fun echo() {
    var m = task.receive();
    task.send(m[0], m[1]);
}
fun roundtrip(v) {
    var t = task.spawn(echo);
    task.send(t, Msg.Ask(main, v));
    return task.receive();
}
var inline = roundtrip(42i);
var boxed = roundtrip(9223372036854775807i);
print inline;
print boxed;
print inline == 42i;
print boxed == 0x7FFFFFFFFFFFFFFF;
print type(boxed);
var wrapped = roundtrip(Msg.Ask(main, 9007199254740993i));
print wrapped[1] == 9007199254740993i;
print wrapped[1] == 9007199254740992i;
task.send(main, 0x8000000000000000);
print task.pending();
print task.receive();
var kind = "sent";
try { task.send(main, 140737488355328i); } catch (e) { kind = e.kind; }
print kind;
print task.receive();
print task.pending();

// STATUS: ok
// CHECK: 42
// CHECK: 9223372036854775807
// CHECK: true
// CHECK: true
// CHECK: Int
// CHECK: true
// CHECK: false
// CHECK: 1
// CHECK: -9223372036854775808
// CHECK: sent
// CHECK: 140737488355328
// CHECK: 0
