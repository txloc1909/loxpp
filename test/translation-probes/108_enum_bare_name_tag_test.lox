// A constructor pattern with no field list, as Opt.Some, is a tag test for a
// constructor with fields too: the arm matches an enum value with that
// constructor, and binds no field
// (spec/04-semantics.md, match Expression, "Constructor patterns"). The
// same holds in an or-chain and as the sub-pattern of an @-binding.
enum Opt { Some(v) None }

print match Opt.None() { case Opt.Some => "some" case Opt.None => "none" };
print match Opt.Some(7) { case Opt.Some => "some" case Opt.None => "none" };
print match Opt.Some(7) { case Opt.None or Opt.Some => "either" };
print match Opt.Some(7) {
    case s @ Opt.Some => "whole " + str(match s { case Opt.Some(v) => v case Opt.None => 0 })
    case Opt.None => "none"
};

// STATUS: ok
// CHECK: none
// CHECK: some
// CHECK: either
// CHECK: whole 7
