// The callee of a defer statement is evaluated exactly as steps 1-2 of
// Function Call (spec/04-semantics.md, defer Statement). So `l.append` in
// `defer l.append(1)` is a property read, and a List is not in Property Get
// steps 2-5: the read is a halting fault at the defer statement.
var l = [];
l.append(1);
print len(l);
fun g() { defer l.append(2); print "body"; }
g();
print len(l);

// STATUS: error
// CHECK: 1
