// A call that waits for the network or for time blocks the worker, and does not
// raise, where the task cannot suspend (spec/04-semantics.md, Contexts where a
// task cannot suspend). Here the call is a sleep() inside `__str__`. The `worker` task prints its lines
// before `ticker` of the same worker runs, because nothing lets `ticker` run
// during the call.
// STATUS: ok
// TIMEOUT: 10
// COVERS: suspend-context str
// CHECK: slow
// CHECK: worker done
// CHECK: ticker ran
class Slow { __str__() { sleep(0.1); return "slow"; } }
var me = task.self();
fun worker() {
    print Slow();
    print "worker done";
    task.send(me, "done");
}
fun ticker() { print "ticker ran"; task.send(me, "done"); }
task.spawn(worker);
task.spawn(ticker);
task.receive();
task.receive();
