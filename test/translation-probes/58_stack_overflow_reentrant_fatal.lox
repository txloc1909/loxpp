// Issue #316: native holds Runtime::m_unwindingStackOverflow (src/runtime.cpp) for
// the duration of one StackOverflowError's own unwind, so a SECOND
// overflow that happens from a deferred call running during that unwind
// is fatal, not delivered to the live handler below.
//
// This is the reentrant twin of 57_stack_overflow_catchable.lox, so it sits
// beside it in the shared directory.
fun deepcall(n) { if (n == 0) return 0; return 1 + deepcall(n - 1); }
fun boom(n) { deepcall(500); }
fun f(n) { defer boom(n); f(n + 1); }
try {
    f(0);
    print "no error";
} catch (e) {
    print "caught " + e.kind;
}
print "after";
