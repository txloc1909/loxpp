// The literal 9223372036854775808i is valid only as the direct operand of a
// unary minus. A parenthesis between them is a static error
// (spec/01-lexical.md, the unary-minus exception).
//
// A static error rejects the program: a non-zero exit status, and nothing
// runs, so nothing prints (spec/README.md, Conformance). The first line
// prints `ran`, so an implementation that finds the error only when it runs
// the program prints `ran` and fails this probe.

print "ran";
print -(9223372036854775808i);

// STATIC-ERROR
// STATUS: error
// COVERS: literal decimal-range
