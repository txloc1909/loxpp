// task.spawn_worker takes only a function that a top-level fun declaration
// made (spec/04-semantics.md, task.spawn_worker). A function declared inside
// another function is not one, so the call is a runtime error. The error of
// a stdlib native is a halting fault (the Halting Faults table), so nothing
// after it prints. No try surrounds the call: an implementation may make a
// halting fault catchable (spec/README.md, Conformance).
fun outer() {
    fun inner(m) {
        print "inner ran";
    }
    return inner;
}

print type(task.self());
task.spawn_worker(outer(), nil);
print "spawned";
print "after";

// STATUS: error
// CHECK: Task
