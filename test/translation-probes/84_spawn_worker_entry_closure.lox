// task.spawn_worker takes only a function that a top-level fun declaration
// made (spec/04-semantics.md, task.spawn_worker). A function declared inside
// another function is not one, so the call is a runtime error. The error of
// a stdlib native is fatal (the Fatal Runtime Errors table), so the try
// does not catch it and nothing after it prints.
fun outer() {
    fun inner(m) {
        print "inner ran";
    }
    return inner;
}

print type(task.self());
try {
    task.spawn_worker(outer(), nil);
    print "spawned";
} catch (e) {
    print "caught " + e.kind;
}
print "after";

// STATUS: error
// CHECK: Task
