// S8 (#1052): the promotion dataflow gives a slot up for three reasons. This
// probe forces the `collapsed` one: a block's phi first collapses onto the
// value every incoming edge carries (the trivial-phi rule), and a later merge
// then contradicts that collapse, so the block must read the slot from its
// stack cell and every incoming edge must write the cell first.
//
// `i` is reused across two loops. The second loop's header reads it in its
// condition, and the `continue` branch adds a third predecessor to that
// header, which is what makes the collapse happen before the contradiction.
// If the block keeps the stale collapsed value instead of the cell, the
// header's condition never sees the decremented `i` and the loop never ends.
fun f() {
  var i = 0;
  while (i < 3) { i = i + 1; }
  var pass = 0;
  while (i >= 0) {
    var j = 0;
    while (j < 2) { j = j + 1; }
    if (pass > 1) { i = i - 1; pass = pass + 1; continue; }
    i = i - 1;
    pass = pass + 1;
  }
  return str(i) + "/" + str(pass);
}

print f();
