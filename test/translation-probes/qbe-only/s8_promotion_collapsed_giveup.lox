// S8 (#1103): the promotion dataflow leaves a slot in its stack cell at three
// sites, and this probe forces the `collapsed` one. A block's phi is created,
// then collapses onto the one value its predecessors carry (the trivial-phi
// rule), and a later merge contradicts that collapse. The block then carries
// no register value for the slot, so it reads the slot from its stack cell
// wherever it reads it, and every later block that inherits its state does the
// same. The pass after the value flow writes the cell on every incoming edge
// that carries the slot in a register.
//
// `i` is reused across two loops: the first raises it to 3, the second
// decrements it. The give-up for `i` lands on the second loop's inner header
// (the `while (j < 2)` block), which does not itself read `i`; the blocks of
// the second loop's body inherit the missing value and read `i` from its cell.
// With the give-up, `i = i - 1` reads the cell and the outer loop ends.
// Without it those blocks keep the collapsed value (3), so every iteration
// sets `i` back to 2 and `while (i >= 0)` never ends: removing the site from
// qbe_promotion.cpp makes this probe time out instead of printing -1/4.
fun f() {
  var i = 0;
  while (i < 3) { i = i + 1; }
  var pass = 0;
  while (i >= 0) {
    var j = 0;
    while (j < 2) { j = j + 1; }
    if (pass > 1) { i = i - 1; pass = pass + 1; continue; }
    i = i - 1;
    pass = pass + 1;
  }
  return str(i) + "/" + str(pass);
}

print f();
