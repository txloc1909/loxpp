// Every Int operation wraps in two's complement (spec/04-semantics.md,
// Arithmetic). The first half runs each operator on values that the program
// holds in variables, so the operation runs at run time. The second half
// writes literal operands, which a compiler can fold. The operands run from
// small values to the smallest and the largest Int, and across the range that
// an implementation may hold inline.

fun add(a, b) { return a + b; }
fun sub(a, b) { return a - b; }
fun mul(a, b) { return a * b; }
fun neg(a) { return -a; }
print add(0i, 0i);
print add(1i, 2i);
print add(-1i, 1i);
print add(5i, -3i);
print add(-7i, -9i);
print add(2147483648i, 2147483648i);
print add(140737488355327i, 1i);
print add(-140737488355328i, -1i);
print add(140737488355327i, 140737488355327i);
print add(9007199254740992i, 1i);
print add(9007199254740993i, 1i);
print add(4611686018427387904i, 4611686018427387904i);
print add(9223372036854775807i, 1i);
print add(9223372036854775807i, 9223372036854775807i);
print add(-9223372036854775808i, -1i);
print add(-9223372036854775808i, -9223372036854775808i);
print add(-9223372036854775808i, 1i);
print add(9223372036854775807i, -9223372036854775808i);
print add(6148914691236517205i, 3074457345618258602i);
print add(-123456789012345i, 987654321098765i);
