// A deferred call runs to completion before the function it belongs to
// returns, so a yield in it is a yield across a native callback
// (spec/04-semantics.md, yield Expression): it raises the catchable
// YieldAcrossNativeError, also in the main task outside every coroutine. The
// fault leaves g, and the try around the call of g catches it.
fun note() {
    var v = yield 1;
    print "defer got " + str(v);
}

fun g() {
    defer note();
    print "g body";
}

try {
    g();
} catch (e) {
    print e.kind;
}
print "after";

// STATUS: ok
// CHECK: g body
// CHECK: YieldAcrossNativeError
// CHECK: after
