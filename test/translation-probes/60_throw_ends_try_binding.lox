// 60_throw_ends_try_binding.lox — verification probe (issue #386).
//
// A throw unwinds past try-body locals without running endScope, so the
// unwinding side must end their bindings itself. The first half throws a
// string, the second half faults with IndexOutOfBoundsError: both share
// the one unwind. The throws sit behind flags so the normal-path close
// stays a live close (the capture corpus holds no dead closes).
//
// Moved out of clr-only/ (was 55_throw_ends_try_binding.lox there) once
// issue #388's fix let the JVM side verify and run this shape too. Runs
// identically on native, JVM, and CLR now; wired into both
// tools/check_jvm_probes.sh and tools/check_clr_probes.sh.
// Expected output:
//
// boom
// 42
// IndexOutOfBoundsError
// 2
var fns = [];
var doThrow = true;
try {
    var x = 41;
    fun c() { return x + 1; }
    fns.append(c);
    if (doThrow) { throw "boom"; }
} catch (e) { print e; }
print fns[0]();
try {
    var y = 1;
    fun d() { return y + 1; }
    fns.append(d);
    if (doThrow) { print [1][5]; }
} catch (e) { print e.kind; }
print fns[1]();
