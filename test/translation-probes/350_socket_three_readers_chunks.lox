// Three tasks call one Socket, each in one call: two in read_some(2) and one
// in read_bytes(2). The peer sends "abcdef" in one write and keeps the
// connection open. Issue #1047 checked that every byte went to exactly one
// task. Under the rule of one call per side (spec/04-semantics.md, The Task
// Machine, Sides), only one call waits: `some1` waits with no bytes to read
// and holds the read side, so the calls of `some2` and `exact` raise
// BusyError and take no byte. The peer writes only after that. `some1` then
// reads the stream with read_some(2) until it has six bytes. Each result has
// one or two bytes, and the results, in order, are the bytes of the stream
// (spec/05-stdlib.md, Socket).
// STATUS: ok
// TIMEOUT: 30
// CHECK: some2: BusyError
// CHECK: exact: BusyError
// CHECK: some1: abcdef, pieces of 1 or 2 bytes: true
fun peer(main) {
    var srv = listen("127.0.0.1", 0);
    task.send(main, srv.port());
    var c = srv.accept();
    task.receive();
    c.write("abcdef");
    task.receive();
}
var me = task.self();
var w = task.spawn_worker(peer, me);
var s = connect("127.0.0.1", task.receive());
fun some1() {
    var text = "";
    var sizes_ok = true;
    while (len(text) < 6) {
        var piece = s.read_some(2);
        if (len(piece) < 1 or len(piece) > 2) sizes_ok = false;
        if (len(piece) == 0) break;
        text = text + piece;
    }
    task.send(me, "some1: " + text + ", pieces of 1 or 2 bytes: " + str(sizes_ok));
}
fun some2() {
    try {
        s.read_some(2);
        task.send(me, "some2: no fault");
    } catch (e) {
        task.send(me, "some2: " + e.kind);
    }
}
fun exact() {
    try {
        s.read_bytes(2);
        task.send(me, "exact: no fault");
    } catch (e) {
        task.send(me, "exact: " + e.kind);
    }
    task.send(w, "write");
}
task.spawn(some1);
task.spawn(some2);
task.spawn(exact);
for (var i = 0; i < 3; i = i + 1) {
    try {
        print task.receive_within(3);
    } catch (e) {
        print "missing: " + e.kind;
    }
}
task.send(w, "done");
