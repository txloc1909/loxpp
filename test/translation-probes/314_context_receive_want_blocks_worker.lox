// A call that waits for the network or for time blocks the worker, and does not
// raise, where the task cannot suspend (spec/04-semantics.md, Contexts where a
// task cannot suspend). Here the call is a sleep() inside the `want` of
// task.receive_where. The `worker` task prints its lines before `ticker` of the
// same worker runs, because nothing lets `ticker` run during the call.
// STATUS: ok
// TIMEOUT: 10
// COVERS: suspend-context receive-want
// CHECK: worker got m
// CHECK: worker done
// CHECK: ticker ran
var me = task.self();
fun slow(m) {
    sleep(0.1);
    return true;
}
fun worker() {
    print "worker got " + task.receive_where(slow);
    print "worker done";
    task.send(me, "done");
}
fun ticker() { print "ticker ran"; task.send(me, "done"); }
var w = task.spawn(worker);
task.send(w, "m");
task.spawn(ticker);
task.receive();
task.receive();
