// When several waits end together, the tasks whose sleep has expired or whose
// limit has passed join the run queue in the order of their deadlines
// (spec/04-semantics.md, Scheduling). The three tasks begin to wait together;
// they run in the order of the deadlines 0.1, 0.3, and 0.5, whatever the order
// of their calls. A sleep is one of the waits.
// The CHECK lines do not bind the bootstrap interpreter. It runs every worker on
// one host thread, so a blocking call blocks every task (spec/README.md,
// Conformance: scheduling is implementation-defined). The probe on the
// NOT-BINDING line checks the bootstrap's own choice in its place.
// STATUS: ok
// TIMEOUT: 30
// NOT-BINDING: bootstrap bootstrap-only/same_worker_blocking_call.lox
// CHECK: limit 0.1
// CHECK: sleep 0.3
// CHECK: limit 0.5
var me = task.self();
fun limited(seconds) {
    try {
        task.receive_within(seconds);
    } catch (e) {
        print "limit " + str(seconds);
    }
    task.send(me, "done");
}
fun late() { limited(0.5); }
fun early() { limited(0.1); }
fun sleeper() {
    sleep(0.3);
    print "sleep 0.3";
    task.send(me, "done");
}
task.spawn(late);
task.spawn(sleeper);
task.spawn(early);
task.receive();
task.receive();
task.receive();
