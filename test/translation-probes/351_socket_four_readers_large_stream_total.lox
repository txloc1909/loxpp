// Four tasks read one Socket until the end of the stream: two with read_some
// and two with read_bytes. The peer, on its own worker, writes 200000 bytes in
// pieces and then closes its write side. Issue #1047 checked that no byte is
// lost or repeated. Under the rule of one call per side (spec/04-semantics.md,
// The Task Machine, Sides), a call made while the call of another task holds
// the read side raises BusyError and takes no byte. Each reader catches that
// fault, sleeps, and calls again; a reader whose call returns holds nothing.
// So the four counts together are 200000 (spec/05-stdlib.md, Socket: the bytes
// of all results, in order, are the bytes of the stream). Which task reads
// which byte, and how often a call raises BusyError, depend on the network,
// so the probe checks the sum and the count of the character "x", which the
// peer puts at known places.
// STATUS: ok
// TIMEOUT: 60
// CHECK: received 4 counts
// CHECK: total bytes 200000
// CHECK: total x 2000
fun peer(main) {
    var srv = listen("127.0.0.1", 0);
    task.send(main, srv.port());
    var c = srv.accept();
    var piece = "";
    var k = 0;
    while (k < 99) { piece = piece + "."; k = k + 1; }
    piece = piece + "x";
    var sent = 0;
    while (sent < 200000) {
        c.write(piece);
        c.write(piece);
        sent = sent + 200;
        if (sent % 1000 == 0) { sleep(0.0005); }
    }
    c.close_write();
    task.receive();
}
var me = task.self();
var w = task.spawn_worker(peer, me);
var s = connect("127.0.0.1", task.receive());
fun tally(text, counts) {
    counts[0] = counts[0] + len(text);
    var i = 0;
    while (i < len(text)) {
        if (text[i] == "x") { counts[1] = counts[1] + 1; }
        i = i + 1;
    }
}
// Calls read_some(200) when `some` is true, and read_bytes(777) otherwise.
// Returns nil when another task holds the read side.
fun read_once(some) {
    try {
        if (some) return s.read_some(200);
        return s.read_bytes(777);
    } catch (e) {
        if (e.kind != "BusyError") throw e;
        return nil;
    }
}
fun reader(some) {
    var counts = [0, 0];
    while (true) {
        var text = read_once(some);
        if (text == nil) {
            sleep(0.001);
        } else if (len(text) == 0) {
            break;
        } else {
            tally(text, counts);
            if (some) {
                // More bytes arrive while this task computes.
                var end = clock() + 0.002;
                while (clock() < end) { }
                sleep(0.001);
            }
        }
    }
    task.send(me, counts[0] + 1000000 * counts[1]);
}
fun some_reader() { reader(true); }
fun bytes_reader() { reader(false); }
task.spawn(some_reader);
task.spawn(bytes_reader);
task.spawn(some_reader);
task.spawn(bytes_reader);
// A reader sends its byte count plus 1000000 times its count of "x".
var n = 0;
var sum = 0;
var i = 0;
while (i < 4) {
    try {
        sum = sum + task.receive_within(20);
        n = n + 1;
    } catch (e) {
        // The limit passed: the count stays missing.
    }
    i = i + 1;
}
var total = sum % 1000000;
var xs = (sum - total) / 1000000;
task.send(w, "done");
print "received " + str(n) + " counts";
print "total bytes " + str(total);
print "total x " + str(xs);
