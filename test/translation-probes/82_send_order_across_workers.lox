// The messages that the tasks of one worker send to one target arrive in
// the order of the sends (spec/04-semantics.md, task.send). A worker and
// the main task exchange ten messages each way. The handle that the worker
// sends of itself is == to the handle task.spawn_worker returned.
fun entry(main) {
    task.send(main, task.self());
    var i = 0;
    while (i < 10) {
        var n = task.receive();
        task.send(main, n * 10);
        i = i + 1;
    }
}

var w = task.spawn_worker(entry, task.self());
print task.receive() == w;
var i = 0;
while (i < 10) {
    task.send(w, i);
    i = i + 1;
}
var line = "";
i = 0;
while (i < 10) {
    if (i > 0) line = line + " ";
    line = line + str(task.receive());
    i = i + 1;
}
print line;

