// Proves runtime/jvm/src/lox/LoxClosure.java's s_unwindingStackOverflow
// guard does not clear on a fault unrelated to the overflow it is watching
// for. `helper` returns normally; its own deferred call's throw is not a
// replacement of anything, since no fault is propagating out of `helper`
// at all. That throw must not be handed the guard's identity, even though
// it escapes a deferred call while a real StackOverflowError unwinds
// elsewhere in the program. `boom`'s local catch of the unrelated fault
// must not clear the guard: `deepcall(500)` right after it overflows again
// while the first overflow is still unwinding, which spec/04-semantics.md
// line 1119 makes fatal — matching native, which never confuses an
// unrelated throw with a replacement of the fault it is unwinding.
//
// Lives in jvm-only/ for the same reason catch_overflow.lox does: the CLR
// backend does not yet deliver this fault with the correct catchability
// (issue #238).
class Fake {}
fun t() { throw Fake(); }
fun helper() { defer t(); }
fun deepcall(n) { if (n == 0) return 0; return deepcall(n - 1); }
fun boom(n) {
  try { helper(); } catch (e) { }
  deepcall(500);
}
fun f(n) { defer boom(n); f(n + 1); }
try { f(0); } catch (e) { print "caught " + e.kind; }
print "after";
