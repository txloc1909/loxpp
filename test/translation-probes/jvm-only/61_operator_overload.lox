class Vec {
  init(x) { this.x = x; }
  __add__(o) { return this.x + o.x; }
  __sub__(o) { return this.x - o.x; }
  __mul__(o) { return this.x * o.x; }
  __div__(o) { return this.x / o.x; }
  __mod__(o) { return this.x % o.x; }
  __neg__() { return -this.x; }
  __lt__(o) { return this.x < o.x; }
  __gt__(o) { return this.x > o.x; }
  __eq__(o) { return this.x == o.x; }
}

class Box {
  init(x) { this.x = x; }
  __contains__(v) { return v == this.x; }
  __call__(n) { return this.x + n; }
}

class Table {
  init() { this.cells = 0; }
  __index_get__(k) { return this.cells + k; }
  __index_set__(k, v) { this.cells = v; return 999; }
}

class Slicer {
  init(n) { this.n = n; }
  __slice__(start, end) { return this.n + start * 100 + end; }
}

class Sized { __len__() { return 5; } }
class BadLen { __len__() { return "nope"; } }

class BadStr { __str__() { return 42; } }

var a = Vec(3);
var b = Vec(4);
print a + b;
print a - b;
print a * b;
print a / b;
print a % b;
print -a;
print a < b;
print a > b;
print a == b;
print a != b;
print a <= b;
print a >= b;

var box = Box(10);
print 10 in box;
print 3 in box;
print box(5);

var t = Table();
print t[10];
print (t["k"] = 7);
print t[0];

var sl = Slicer(1000);
print sl[3:4];
print [10, 20, 30, 40][1:3];
print "hello"[1:3];

print len([1, 2, 3]);
print len("ab");
print len(Sized());
try { var bad = len(BadLen()); } catch (e) { print "caught " + e.kind; }

class WithStr {
  init(n) { this.n = n; }
  __str__() { return "S" + str(this.n); }
}
print WithStr(1);
print str(WithStr(2));
print [WithStr(3), 9];
print {"k": WithStr(4)};
print str(42);
print str("hi");
try { var badstr = str(BadStr()); } catch (e) { print "caught " + e.kind; }
try { print BadStr(); } catch (e) { print "caught " + e.kind; }

class AlwaysEq { __eq__(o) { return true; } }
var e1 = AlwaysEq();
var e2 = AlwaysEq();
print e1 in [e2];
print e1 == e2;

print 1 + 2;
print "x" + "y";

class Range {
  init(n) { this.n = n; }
  __iter__() {
    var out = [];
    var i = 0;
    while (i < this.n) { out.append(i); i = i + 1; }
    return out;
  }
}
var total = 0;
for (var x in Range(3)) { total = total + x; }
print total;

class BadSeq { __iter__() { return 1; } }
try { for (var y in BadSeq()) {} } catch (e) { print "caught " + e.kind; }

class Refl {
  init(x) { this.x = x; }
  __radd__(o) { return o + this.x; }
  __rsub__(o) { return o - this.x; }
  __rmul__(o) { return o * this.x; }
  __rdiv__(o) { return o / this.x; }
  __rmod__(o) { return o % this.x; }
  __rlt__(o) { return o < this.x; }
  __rgt__(o) { return o > this.x; }
  __eq__(o) { return o == this.x; }
}
print 10 + Refl(3);
print 10 - Refl(3);
print 10 * Refl(3);
print 10 / Refl(4);
print 10 % Refl(3);
print 2 < Refl(3);
print 2 > Refl(3);
print 2 <= Refl(3);
print 2 >= Refl(3);
print 2 == Refl(2);
print 2 != Refl(2);
