class Vec {
  init(x) { this.x = x; }
  __add__(o) { return this.x + o.x; }
  __sub__(o) { return this.x - o.x; }
  __mul__(o) { return this.x * o.x; }
  __div__(o) { return this.x / o.x; }
  __mod__(o) { return this.x % o.x; }
  __neg__() { return -this.x; }
  __lt__(o) { return this.x < o.x; }
  __gt__(o) { return this.x > o.x; }
  __eq__(o) { return this.x == o.x; }
}

class Box {
  init(x) { this.x = x; }
  __contains__(v) { return v == this.x; }
  __call__(n) { return this.x + n; }
}

class Table {
  init() { this.cells = 0; }
  __index_get__(k) { return this.cells + k; }
  __index_set__(k, v) { this.cells = v; return 999; }
}

class Sized { __len__() { return 5; } }
class BadLen { __len__() { return "nope"; } }

var a = Vec(3);
var b = Vec(4);
print a + b;
print a - b;
print a * b;
print a / b;
print a % b;
print -a;
print a < b;
print a > b;
print a == b;
print a != b;
print a <= b;
print a >= b;

var box = Box(10);
print 10 in box;
print 3 in box;
print box(5);

var t = Table();
print t[10];
print (t["k"] = 7);
print t[0];

print len([1, 2, 3]);
print len("ab");
print len(Sized());
try { var bad = len(BadLen()); } catch (e) { print "caught " + e.kind; }

class AlwaysEq { __eq__(o) { return true; } }
var e1 = AlwaysEq();
var e2 = AlwaysEq();
print e1 in [e2];
print e1 == e2;

print 1 + 2;
print "x" + "y";
