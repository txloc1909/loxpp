// Two tasks call readline() on one Socket. The peer sends two lines in one
// write and then closes its write side. Issue #1047 found that the bytes that
// one task read could be lost to the other, and that the other task could see
// an end of stream while a line remained. Under the rule of one call per side
// (spec/04-semantics.md, The Task Machine, Sides), the second reader does not
// wait: `first` waits with no bytes to read and holds the read side, so the
// call of `second` raises BusyError. The peer writes only after that. `first`
// then reads both lines, and the end of stream comes after the last line
// (spec/05-stdlib.md, Socket).
// STATUS: ok
// TIMEOUT: 30
// CHECK: second: BusyError
// CHECK: first: a, b, nil
fun peer(main) {
    var srv = listen("127.0.0.1", 0);
    task.send(main, srv.port());
    var c = srv.accept();
    task.receive();
    c.write("a\nb\n");
    c.close_write();
    task.receive();
}
var me = task.self();
var w = task.spawn_worker(peer, me);
var s = connect("127.0.0.1", task.receive());
fun first() {
    var x = s.readline();
    var y = s.readline();
    task.send(me, "first: " + str(x) + ", " + str(y) + ", " + str(s.readline()));
}
fun second() {
    try {
        s.readline();
        task.send(me, "second: no fault");
    } catch (e) {
        task.send(me, "second: " + e.kind);
    }
    task.send(w, "write");
}
task.spawn(first);
task.spawn(second);
for (var i = 0; i < 2; i = i + 1) {
    try {
        print task.receive_within(3);
    } catch (e) {
        print "missing: " + e.kind;
    }
}
task.send(w, "done");
