// A host that names no address — a name the resolver refuses, and the empty
// name — raises a catchable NetworkError from listen, connect and
// connect_within (spec/05-stdlib.md, connect, connect_within, listen).
//
// The listener makes the empty-name cases discriminating. An empty name
// resolves to the loopback address on a JVM, so a backend that binds or
// connects it succeeds against this listener and prints "no error", while
// the C library's getaddrinfo resolves no address for it. The name "a b"
// holds a space, so no resolver answers it.
//
// This probe does not name the other direction of the same question: the C
// library answers "*", "0x7f000001" and "0177.0.0.1", and the JVM's
// resolver refuses each one, so native binds the wildcard address or a
// loopback address where the JVM raises NetworkError. A probe must pass on
// every consumer, so that difference is recorded in issue #1095, not here.
// STATUS: ok
// CHECK: listen with an unresolved name: NetworkError
// CHECK: listen with an empty name: NetworkError
// CHECK: connect with an unresolved name: NetworkError
// CHECK: connect with an empty name: NetworkError
// CHECK: connect_within with an unresolved name: NetworkError
// CHECK: connect_within with an empty name: NetworkError
// CHECK: after
var srv = listen("127.0.0.1", 0);
var port = srv.port();
var bad = "a b";

try {
    var s = listen(bad, 0);
    print "listen with an unresolved name: no error";
    s.close();
} catch (e) {
    print "listen with an unresolved name: " + e.kind;
}

try {
    var s = listen("", 0);
    print "listen with an empty name: no error";
    s.close();
} catch (e) {
    print "listen with an empty name: " + e.kind;
}

try {
    var c = connect(bad, port);
    print "connect with an unresolved name: no error";
    c.close();
} catch (e) {
    print "connect with an unresolved name: " + e.kind;
}

try {
    var c = connect("", port);
    print "connect with an empty name: no error";
    c.close();
} catch (e) {
    print "connect with an empty name: " + e.kind;
}

try {
    var c = connect_within(bad, port, 1);
    print "connect_within with an unresolved name: no error";
    c.close();
} catch (e) {
    print "connect_within with an unresolved name: " + e.kind;
}

try {
    var c = connect_within("", port, 1);
    print "connect_within with an empty name: no error";
    c.close();
} catch (e) {
    print "connect_within with an empty name: " + e.kind;
}

srv.close();
print "after";
