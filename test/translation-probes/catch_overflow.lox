// Proves runtime/jvm/src/lox/LoxClosure.java delivers its own
// StackOverflowError to a real catchBlock — kind, message, and the "after"
// line that only runs once the catch block completes normally
// (spec/04-semantics.md's Runtime Errors table).
fun f(n) { return f(n + 1); }
try {
    f(0);
    print "no error";
} catch (e) {
    print "caught " + e.kind;
    print e.message;
}
print "after";
