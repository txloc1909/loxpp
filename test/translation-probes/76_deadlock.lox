// When the main task waits in task.receive() and no task on any worker can
// run again, the program ends with DeadlockError (spec/04-semantics.md,
// Deadlock). It is a halting fault, so the code after the receive does not
// run. Whether the pending deferred call runs is implementation-defined
// (spec/README.md, Conformance), so no CHECK line follows the receive, and no
// try surrounds it, because an implementation may make a halting fault
// catchable. A task on a second worker waits too, so the check spans workers.
fun waiter() {
    print "waiter waits";
    task.receive();
    print "waiter woke";
}

fun far(m) {
    task.receive();
}

fun print_deferred() {
    print "deferred call ran";
}

fun run() {
    defer print_deferred();
    task.spawn(waiter);
    task.spawn_worker(far, nil);
    print "main waits";
    task.receive();
    print "main woke";
}

run();
print "after";

// STATUS: error
// CHECK: main waits
// CHECK: waiter waits
