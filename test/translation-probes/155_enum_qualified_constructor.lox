// A program writes the constructor A of the enum E as E.A, in an expression
// and in a pattern (spec/02-syntax.md, enum declaration and Extended match
// arm patterns; spec/04-semantics.md, Constructor Reference and match
// Expression, "Constructor patterns"). A constructor is a value, and its
// string forms name the constructor only (spec/04-semantics.md, Enum Types).
enum Opt { Some(v) None }
enum Pair { P(a, b) }

var s = Opt.Some(7);
var n = Opt.None();
print s;
print n;
print Opt.Some;
print type(Opt.Some);
print type(s);
var make = Opt.Some;
print make(8);
print Opt.Some == Opt.Some;
print Opt.Some == Opt.None;

fun show(o) {
    return match o {
        case Opt.Some(v) => "some " + str(v)
        case Opt.None    => "none"
    };
}
print show(s);
print show(n);

print match Pair.P(1, 2) { case Pair.P(_, b) => b };
print match Pair.P(1, 2) { case Pair.P{a} => a };
print match s { case whole @ Opt.Some(v) => str(whole) + " holds " + str(v) case _ => "other" };
print match s { case Opt.Some => "tag only" case Opt.None => "none" };

// STATUS: ok
// CHECK: Some(7)
// CHECK: None
// CHECK: <Some>
// CHECK: EnumConstructor
// CHECK: Enum
// CHECK: Some(8)
// CHECK: true
// CHECK: false
// CHECK: some 7
// CHECK: none
// CHECK: 2
// CHECK: 1
// CHECK: Some(7) holds 7
// CHECK: tag only
