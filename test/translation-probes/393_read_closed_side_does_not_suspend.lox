// Invariant I2: no task waits while the condition of its wait is already true
// (spec/04-semantics.md, Suspend Points: a call of class suspends waits only when the wait is not over at the call).
// The read side is closed before the call, so `readline()` raises at once (Sides, rule 6).
// Task `other` is ready when `t` makes the call. If the call returns at once, `t`
// sends its result before `other` runs. A call that suspends anyway lets `other` send
// first, or never returns.
// STATUS: ok
// TIMEOUT: 30
// CHECK: t: SocketClosedError
// CHECK: other
var srv = listen("127.0.0.1", 0);
var peer = connect("127.0.0.1", srv.port());
var conn = srv.accept();
var me = task.self();
fun other() { task.send(me, "other"); }
fun t() {
    conn.close();
    try {
        conn.readline();
        task.send(me, "t: no fault");
    } catch (e) {
        task.send(me, "t: " + e.kind);
    }
}
task.spawn(t);
task.spawn(other);
for (var i = 0; i < 2; i = i + 1) {
    try {
        print task.receive_within(3);
    } catch (e) {
        print "missing: " + e.kind;
    }
}
