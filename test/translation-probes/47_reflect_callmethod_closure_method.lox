// callMethod() on a closure-backed user method runs on every backend (issue
// #496), through the host VM's re-entrant call path. `this` binds to the
// receiver, forwarded args arrive in order, and a throw inside the method is
// catchable. Prints byte-identically on native and JVM.
class Greeter {
    init(name) { this.name = name; }
    greet(who) { return "hi " + who + " from " + this.name; }
    boom() { throw "kaboom"; }
}
var g = Greeter("G");
print callMethod(g, "greet", "Bob");

try {
    callMethod(g, "boom");
} catch (e) {
    print "caught " + e;
}
print "done";
