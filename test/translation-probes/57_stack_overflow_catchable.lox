// Issue #238 / #267: unbounded recursion overflows the call stack, and
// spec/04-semantics.md marks StackOverflowError catchable, matching every
// other runtime fault. A live handler must catch a real Error value (not
// nil) with kind "StackOverflowError", the same as native.
//
// Promoted to shared directory (issue #322) now that both JVM (#268) and CLR
// (#238) backends deliver catchable StackOverflowError.
fun f(n) { return f(n + 1); }
try {
    f(0);
    print "no error";
} catch (e) {
    print "caught";
    print e == nil;
    print e.kind;
}
print "after";
