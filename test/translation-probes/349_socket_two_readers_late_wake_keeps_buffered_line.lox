// Two tasks call readline() on one Socket. The peer, on its own worker, sends
// "a\nb\n" and later "c\n". Issue #1047 found that a task that woke after
// more bytes had arrived could lose the line that another task left in the
// buffer. Under the rule of one call per side (spec/04-semantics.md, The Task
// Machine, Sides), the second reader does not wait: `first` waits with no
// bytes to read and holds the read side, so the call of `second` raises
// BusyError. The peer writes only after that. `first` gets "a", computes for
// longer than the gap between the two writes of the peer, and then reads
// again: "b" is still in the buffer, and "c" comes after it (spec/05-stdlib.md,
// Socket: the bytes of all results, in order, are the bytes of the stream).
// STATUS: ok
// TIMEOUT: 30
// CHECK: second: BusyError
// CHECK: first: a, b, c
fun peer(main) {
    var srv = listen("127.0.0.1", 0);
    task.send(main, srv.port());
    var c = srv.accept();
    task.receive();
    c.write("a\nb\n");
    sleep(0.1);
    c.write("c\n");
    task.receive();
}
var me = task.self();
var w = task.spawn_worker(peer, me);
var s = connect("127.0.0.1", task.receive());
fun first() {
    var x = s.readline();
    var end = clock() + 0.15;
    while (clock() < end) { }
    var y = s.readline();
    task.send(me, "first: " + str(x) + ", " + str(y) + ", " + str(s.readline()));
}
fun second() {
    try {
        s.readline();
        task.send(me, "second: no fault");
    } catch (e) {
        task.send(me, "second: " + e.kind);
    }
    task.send(w, "write");
}
task.spawn(first);
task.spawn(second);
for (var i = 0; i < 2; i = i + 1) {
    try {
        print task.receive_within(3);
    } catch (e) {
        print "missing: " + e.kind;
    }
}
task.send(w, "done");
