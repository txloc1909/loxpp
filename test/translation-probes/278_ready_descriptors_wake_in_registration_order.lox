// When several waits end together, the tasks whose descriptors are ready join the
// run queue in the order in which their calls began to wait (spec/04-semantics.md,
// Scheduling). `reader_b` waits first, then `reader_a`, although the connection of
// `reader_a` was opened first. The `writer` task sends to the connection of
// `reader_a` first and to the other second, in one run, so both are ready
// together. The readers wake in the order of their calls: b, then a. This order
// differs from the order in which the connections were opened and from the order
// in which they became ready.
// STATUS: ok
// TIMEOUT: 10
// CHECK: b got B
// CHECK: a got A
var srv = listen("127.0.0.1", 0);
var a_out = connect("127.0.0.1", srv.port());
var a_in = srv.accept();
var b_out = connect("127.0.0.1", srv.port());
var b_in = srv.accept();
var me = task.self();
fun reader_a() { print "a got " + a_in.readline(); task.send(me, "done"); }
fun reader_b() { print "b got " + b_in.readline(); task.send(me, "done"); }
fun writer() {
    a_out.writeline("A");
    b_out.writeline("B");
    task.send(me, "done");
}
task.spawn(reader_b);
task.spawn(reader_a);
task.spawn(writer);
task.receive();
task.receive();
task.receive();
