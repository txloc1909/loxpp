// Two Ints compare by their signed value, for every value of the 64 bits
// (spec/04-semantics.md, Comparison). The pairs include the smallest and the
// largest Int, and neighbours at 2^47, 2^53, and 2^62, where a comparison that
// went through a double or through a narrower integer would be wrong.

fun lt(a, b) { return a < b; }
fun le(a, b) { return a <= b; }
fun gt(a, b) { return a > b; }
fun ge(a, b) { return a >= b; }
print lt(1i, 2i);
print lt(2i, 1i);
print lt(1i, 1i);
print lt(-1i, 1i);
print lt(1i, -1i);
print lt(-2i, -1i);
print lt(-9223372036854775808i, 9223372036854775807i);
print lt(9223372036854775807i, -9223372036854775808i);
