// Task B waits in read_some(10) on a Socket. Task A runs, calls readline() and
// reads both writes of the peer in one read. The bytes after the first line
// stay in the buffer of the Socket and the descriptor has no new bytes. B must
// get them. The probe checks the pair of results, because the spec does not
// say which task gets which line.
// The CHECK line does not bind the bootstrap interpreter. It runs every worker
// on one host thread, so a blocking read of the first task keeps the other
// task from running (spec/README.md, Conformance: scheduling is
// implementation-defined). The probe on the NOT-BINDING line checks the
// bootstrap's own choice in its place.
// STATUS: ok
// TIMEOUT: 20
// NOT-BINDING: bootstrap bootstrap-only/same_worker_blocking_call.lox
// CHECK: results are x and yz: true
fun peer(main) {
    var srv = listen("127.0.0.1", 0);
    task.send(main, srv.port());
    var c = srv.accept();
    sleep(0.2);
    c.write("x\nyz\n");
    task.receive();
}
var me = task.self();
var w = task.spawn_worker(peer, me);
var s = connect("127.0.0.1", task.receive());
fun spin(secs) {
    var end = clock() + secs;
    while (clock() < end) { }
}
fun b() { task.send(me, str(s.read_some(10))); }
fun a() { spin(0.5); task.send(me, str(s.readline())); }
task.spawn(b);
task.spawn(a);
var r0 = "timeout";
try { r0 = task.receive_within(3); } catch (e) { }
var r1 = "timeout";
try { r1 = task.receive_within(3); } catch (e) { }
task.send(w, "done");
print "results are x and yz: " + str((r0 == "x" and r1 == "yz\n") or (r0 == "yz\n" and r1 == "x"));
