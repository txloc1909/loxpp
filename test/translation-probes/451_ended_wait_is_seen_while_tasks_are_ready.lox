// A worker whose run queue is never empty still sees the end of a socket wait
// (spec/04-semantics.md, Scheduling: while tasks are ready to run the worker
// looks for ended waits at a task switch, and no later than the first switch at
// which at least a bounded delay has passed since its previous look).
// `reader` parks in readline on `conn`. `busy` yields in a loop, so a task is
// ready at every instant and the worker never goes idle. The peer writes
// the line after the reader has parked, and the reader must wake and print it.
// A scheduler that looks at the network only when its run queue is empty never
// wakes the reader, and this probe times out. That is what the probe proves: it
// does not pin the size of the delay, which the spec leaves to the
// implementation. The TIMEOUT below is a limit of the runner, not of the spec,
// and it is the only maximum here: a poll interval of 4 s still passes this
// probe, and 20 s does not.
// STATUS: ok
// TIMEOUT: 10
// CHECK: the reader got the line: line
// CHECK: the busy task is still running: true
var srv = listen("127.0.0.1", 0);
var peer = connect("127.0.0.1", srv.port());
var conn = srv.accept();
var me = task.self();
var busyRuns = 0;

fun reader() {
    var line = conn.readline();
    print "the reader got the line: " + line;
    task.send(me, "read");
}

fun busy() { while (true) { busyRuns = busyRuns + 1; yield; } }

fun writer() {
    sleep(0.05);
    peer.writeline("line");
    task.send(me, "wrote");
}

task.spawn(reader);
task.spawn(busy);
task.spawn(writer);
task.receive();
task.receive();
print "the busy task is still running: " + str(busyRuns > 0);
