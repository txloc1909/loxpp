// A destructuring declaration whose source is a Number is a halting fault,
// also inside a try, because a Number is not in Property Get steps 2-5
// (spec/04-semantics.md, Destructuring Declaration and Property Get step 6).
try {
    var {x} = 42;
    print x;
} catch (e) {
    print "caught " + e.kind;
}
print "unreachable";

// STATUS: error
