print mod(-9223372036854775808i, 2i);
print mod(-9223372036854775808i, -2i);
print mod(-9223372036854775808i, 1i);
print mod(-9223372036854775808i, -1i);
print mod(9223372036854775807i, -1i);
print mod(-9223372036854775807i, -1i);
print mod(9223372036854775807i, 9223372036854775807i);
print mod(-9223372036854775808i, -9223372036854775808i);
print mod(1i, -9223372036854775808i);
print mod(-1i, 9223372036854775807i);
print mod(9007199254740993i, 2i);
print mod(123456789012345678i, 1000i);
print mod(-123456789012345678i, 1000i);
print mod(-123456789012345678i, -1000i);
print ident(7i, 2i);
print ident(-7i, 2i);
print ident(7i, -2i);
print ident(-7i, -2i);
print ident(0i, 5i);
print ident(0i, -5i);
print ident(5i, 1i);
print ident(5i, -1i);
print ident(1i, 2i);
print ident(-1i, 2i);
print ident(1i, -2i);
print ident(-1i, -2i);
print ident(9223372036854775807i, 2i);
print ident(-9223372036854775808i, 2i);
print ident(-9223372036854775808i, -2i);
print ident(-9223372036854775808i, 1i);
print ident(-9223372036854775808i, -1i);
print ident(9223372036854775807i, -1i);
print ident(-9223372036854775807i, -1i);
