print ident(1i, -9223372036854775808i);
print ident(-1i, 9223372036854775807i);
print ident(9007199254740993i, 2i);
print ident(123456789012345678i, 1000i);
print ident(-123456789012345678i, 1000i);
print ident(-123456789012345678i, -1000i);
print -7i / 2i;
print -7i % 2i;
print 7i / -2i;
print 7i % -2i;
print -9223372036854775808i / -1i;
print -9223372036854775808i % -1i;

