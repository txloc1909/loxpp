// A match folded into an operand of a binary expression, in a loop: the
// left operand waits on the stack while the match runs, and the binary
// expression consumes it (issue #786). The result is the same as with no
// loop and no match.
var r = "";
for (var x in [1, 3]) { r = r + str(match x { case 1 => "a" case _ => "-" }); }
print r;

fun g(xs) {
    var s = "";
    for (var x in xs) {
        s = s + str(match x { case 1 => "a" case _ => "-" });
    }
    return s;
}
print g([1, 3, 1]);

// STATUS: ok
// CHECK: a-
// CHECK: a-a
