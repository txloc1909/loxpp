// OS / world access natives (src/stdlib/os_api.cpp). A program using them
// must print byte-identically on the native VM and the JVM backend, or the
// differential suite (tools/diff_runtimes.py) DIVERGEs. Every call here
// is chosen to be deterministic across the two runtimes: nothing prints a
// wall-clock or a file mtime (those change between the two back-to-back runs).
// Keep the trailing newline at end of file: the bootstrap interpreter
// rejects a program whose last line lacks one (see issue #328).
print args();
print exists("/tmp");
print is_dir("/tmp");
print is_file("/tmp");
print env("PATH") != nil;
print stat("/tmp/loxpp_missing_probe_xyz_never_created") == nil;
print sleep(0.01);
// mkdir succeeds only once in the one-directory form, so the tree is made in
// parents mode, which is a no-op when a previous run left it in place.
mkdir("/tmp/loxpp_probe_mkdir_29/sub/deeper", "p");
print is_dir("/tmp/loxpp_probe_mkdir_29");
print is_dir("/tmp/loxpp_probe_mkdir_29/sub/deeper");
// An existing path in the one-directory form, and a missing parent, both
// raise the same catchable kind.
try { mkdir("/tmp/loxpp_probe_mkdir_29"); } catch (e) { print e.kind; }
try { mkdir("/tmp/loxpp_probe_mkdir_29/absent/child"); } catch (e) { print e.kind; }
print is_dir("/tmp/loxpp_probe_mkdir_29/absent");
